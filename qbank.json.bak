  {
   "id": "Q_PS_SOM_008",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Somatoform, dissociative, personality & sexual disorders",
   "difficulty": "H",
   "stem": "Obsessive-compulsive personality disorder differs from obsessive-compulsive disorder in that it:",
   "options": [
    "Involves compulsions",
    "Is ego-syntonic, with traits the person accepts rather than resists",
    "Responds to SSRIs",
    "Is ego-dystonic"
   ],
   "correct": 1,
   "concept": "In OCPD the perfectionism, rigidity and preoccupation with order feel right to the person, whereas OCD obsessions are intrusive, unwanted and resisted, causing distress and responding to SSRIs and exposure therapy.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Personality Disorders",
   "tags": [
