   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "M",
   "stem": "The RAS oncogene causes malignant transformation because the mutant protein:",
   "options": [
    "Is degraded",
    "Remains locked in the GTP-bound active state due to loss of GTPase activity",
    "Cannot bind GTP",
    "Binds DNA"
   ],
   "correct": 1,
   "concept": "RAS mutations occur in about 30% of human cancers, notably pancreatic, colorectal and lung. KRAS status predicts resistance to anti-EGFR antibodies in colorectal cancer.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Cancer: An Overview",
   "tags": [
