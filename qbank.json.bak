   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Fluid & electrolyte therapy and diarrhoeal disease in children",
   "difficulty": "M",
   "stem": "In WHO Plan C for severe dehydration, Ringer lactate is given to an infant under 12 months as:",
