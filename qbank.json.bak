  {
   "id": "Q_PSM_VPD_006",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Respiratory & vaccine-preventable disease epidemiology (measles, diphtheria, polio)",
   "difficulty": "M",
   "stem": "The pulse polio immunisation strategy works by:",
   "options": [
    "Immunising adults",
    "Immunising only high-risk children",
    "Continuous routine immunisation",
    "Simultaneously immunising all children under five in a very short period to interrupt transmission"
   ],
   "correct": 3,
   "concept": "Simultaneous administration floods the community with vaccine virus, outcompeting wild virus in the gut and interrupting circulation - a strategy dependent on the live oral vaccine.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Poliomyelitis",
   "tags": [
