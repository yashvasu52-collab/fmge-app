  },
  {
   "id": "Q_OP_SQU_007",
   "part": "B",
   "subject": "Ophthalmology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Squint, amblyopia & neuro-ophthalmology (optic nerve, pupil, fields)",
   "difficulty": "E",
   "stem": "Sixth cranial nerve palsy produces:",
   "options": [
    "Divergent squint",
    "Vertical diplopia",
    "Failure of abduction with convergent squint and horizontal diplopia worse on looking to the affected side",
    "Ptosis"
   ],
   "correct": 2,
   "concept": "The abducens nerve has the longest intracranial course and is vulnerable to raised intracranial pressure, making its palsy a false localising sign. The eye deviates inward from unopposed medial rectus action.",
   "reference": "AK Khurana Comprehensive Ophthalmology 8e, Ch. Neuro-ophthalmology",
   "tags": [
