   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Environmental health: air, noise, housing, climate",
   "difficulty": "M",
   "stem": "The air pollutant most closely associated with cardiorespiratory mortality is:",
   "options": [
    "Nitrogen",
    "Carbon dioxide",
    "PM2.5, fine particulate matter penetrating to the alveoli",
    "Ozone at ground level only"
   ],
   "correct": 2,
   "concept": "Particles under 2.5 micrometres reach the alveoli and enter the circulation, causing systemic inflammation. India's National Clean Air Programme targets reduction in PM2.5 and PM10 concentrations.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Air",
   "tags": [
