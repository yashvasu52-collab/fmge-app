   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Burns & basics of plastic surgery",
   "difficulty": "M",
   "stem": "Which topical antimicrobial is used for most burn wounds, despite penetrating eschar poorly?",
   "options": [
    "Systemic antibiotics alone",
    "Plain petroleum jelly",
    "Mafenide acetate for all burns",
    "Silver sulfadiazine"
   ],
   "correct": 3,
   "concept": "Silver sulfadiazine is widely used and painless but penetrates eschar poorly and may cause transient leucopenia. Mafenide penetrates eschar well, useful for cartilage-containing areas, but is painful and causes metabolic acidosis by carbonic anhydrase inhibition.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Burns",
   "tags": [
