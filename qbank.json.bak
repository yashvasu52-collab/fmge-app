  {
   "id": "Q_BC_CAN_009",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "H",
   "stem": "BRCA1 and BRCA2 genes function in:",
   "options": [
    "Homologous recombination repair of DNA double-strand breaks",
    "Mismatch repair",
    "Nucleotide excision repair",
    "Base excision repair"
   ],
   "correct": 0,
   "concept": "Their loss creates dependence on alternative repair, exploited therapeutically by PARP inhibitors through synthetic lethality. Carriers face high breast, ovarian, prostate and pancreatic cancer risk.",
