   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_OBG_AUB_009",
   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Puberty, amenorrhoea & abnormal uterine bleeding",
   "difficulty": "H",
   "stem": "Precocious puberty in girls is defined as onset of secondary sexual characteristics before:",
   "options": [
    "8 years of age",
    "10 years",
    "6 years",
    "12 years"
   ],
   "correct": 0,
   "concept": "Development before 8 years in girls or 9 in boys defines precocious puberty. Central causes are gonadotropin-dependent, most often idiopathic in girls, and are treated with GnRH agonists to preserve final adult height.",
   "reference": "Nelson Textbook of Pediatrics 21e, Ch. Precocious Puberty",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_OBG_INFT_001",
