  },
  {
   "id": "Q_PH_NSA_006",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "M",
   "stem": "NSAIDs are contraindicated in a patient with which condition?",
   "options": [
    "Hypertension alone",
    "Peptic ulcer disease and chronic kidney disease",
    "Anaemia",
    "Diabetes"
   ],
   "correct": 1,
   "concept": "Loss of protective gastric prostaglandins causes ulceration and bleeding, and loss of afferent arteriolar vasodilatation precipitates acute kidney injury, especially with ACE inhibitors and diuretics - the triple whammy.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. NSAIDs",
   "tags": [
