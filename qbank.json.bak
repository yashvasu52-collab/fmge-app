   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_PRK_005",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Skeletal muscle relaxants & drugs for Parkinsonism",
   "difficulty": "M",
   "stem": "Selegiline acts by:",
   "options": [
    "Being a dopamine agonist",
    "Selectively inhibiting MAO-B, reducing central dopamine breakdown",
    "Inhibiting MAO-A",
    "Blocking COMT"
   ],
   "correct": 1,
   "concept": "MAO-B selectivity avoids the cheese reaction of non-selective MAO inhibitors at usual doses. Entacapone instead inhibits COMT, prolonging levodopa action and reducing end-of-dose wearing off.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Parkinsonism",
   "tags": [
