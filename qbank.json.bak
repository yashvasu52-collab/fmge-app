  {
   "id": "Q_PAT_MDS_001",
   "part": "A",
   "subject": "Pathology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Myelodysplasia, marrow failure & transfusion medicine",
   "difficulty": "E",
   "stem": "Myelodysplastic syndrome is characterised by:",
   "options": [
    "Cytopenias with a hypercellular dysplastic marrow and risk of transformation to acute leukaemia",
    "Isolated lymphocytosis",
    "Normal blood counts",
    "Hypocellular marrow with no dysplasia"
   ],
   "correct": 0,
   "concept": "MDS shows ineffective haemopoiesis - peripheral cytopenias despite a hypercellular marrow - with dysplastic changes such as ring sideroblasts, Pelger-Huet anomaly and micromegakaryocytes, and progresses to AML in about a third.",
   "reference": "Robbins & Cotran Pathologic Basis of Disease 10e, Ch. Diseases of White Blood Cells",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
