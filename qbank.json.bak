  {
   "id": "Q_DE_ECZ_004",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Eczema, atopic & contact dermatitis, urticaria",
   "difficulty": "E",
   "stem": "The commonest cause of allergic contact dermatitis worldwide is:",
   "options": [
    "Wool",
    "Cotton",
    "Water",
    "Nickel"
   ],
   "correct": 3,
   "concept": "Nickel in costume jewellery, watch straps, belt buckles and mobile phones causes dermatitis at points of contact, particularly the earlobes and umbilicus. Chromate in cement and parathenium in India are other important allergens.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Eczema",
   "tags": [
