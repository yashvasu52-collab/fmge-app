  },
  {
   "id": "Q_PH_NSA_007",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "E",
   "stem": "Colchicine relieves acute gout by:",
   "options": [
    "Increasing urate excretion",
    "Blocking xanthine oxidase",
    "Binding tubulin and inhibiting neutrophil migration into the joint",
    "Lowering serum urate"
   ],
   "correct": 2,
   "concept": "Colchicine does not affect urate levels and its usefulness is limited by diarrhoea, vomiting and abdominal pain at effective doses. NSAIDs and steroids are generally preferred for the acute attack.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Gout",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_NSA_008",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "H",
   "stem": "Aspirin in low doses affects urate handling by:",
   "options": [
    "Having no effect",
    "Reducing urate excretion and therefore raising serum urate",
    "Increasing excretion",
    "Inhibiting xanthine oxidase"
   ],
   "correct": 1,
   "concept": "Low-dose aspirin retains urate, whereas high doses are uricosuric. This is why low-dose aspirin can precipitate gout, though its cardiovascular benefit usually outweighs this.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Gout",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_NSA_009",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "H",
   "stem": "Febuxostat differs from allopurinol in that it:",
   "options": [
    "Increases urate production",
    "Is a purine analogue",
    "Is uricosuric",
    "Is a non-purine selective xanthine oxidase inhibitor, usable in allopurinol hypersensitivity"
   ],
   "correct": 3,
   "concept": "Febuxostat is largely hepatically metabolised, so dose adjustment in mild to moderate renal impairment is unnecessary, but concerns about cardiovascular mortality restrict its first-line use.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Gout",
   "tags": [
