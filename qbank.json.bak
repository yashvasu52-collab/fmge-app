   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Innate & adaptive immunity, antigen-antibody reactions, vaccines",
   "difficulty": "M",
   "stem": "Live attenuated vaccines are contraindicated in:",
   "options": [
    "Pregnancy and severe immunodeficiency",
    "Hypertension",
    "Mild fever",
    "Diabetes"
   ],
   "correct": 0,
   "concept": "Live organisms may replicate uncontrollably in immunodeficiency and pose a theoretical fetal risk. BCG, OPV, measles, mumps, rubella, varicella and yellow fever are live; mild illness is not a contraindication.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Immunisation",
   "tags": [
