  },
  {
   "id": "Q_PED_CHD_010",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Congenital & rheumatic heart disease in children",
   "difficulty": "M",
   "stem": "Primary prophylaxis of rheumatic fever consists of:",
   "options": [
    "Lifelong benzathine penicillin",
    "Aspirin for all sore throats",
    "Tonsillectomy",
    "Treating streptococcal pharyngitis with penicillin within nine days of onset"
   ],
   "correct": 3,
   "concept": "Adequate antibiotic treatment of group A streptococcal pharyngitis within nine days prevents a first attack of rheumatic fever - primary prophylaxis. Secondary prophylaxis with three-weekly benzathine penicillin prevents recurrences.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Rheumatic Fever",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
