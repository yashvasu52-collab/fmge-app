  {
   "id": "Q_MIC_HEL_009",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Helminths: intestinal & tissue nematodes, cestodes, trematodes",
   "difficulty": "H",
   "stem": "Katayama fever, an acute hypersensitivity illness with fever, urticaria and eosinophilia, occurs in:",
   "options": [
    "Giardiasis",
    "Acute schistosomiasis",
    "Amoebiasis",
    "Taeniasis"
   ],
   "correct": 1,
   "concept": "Katayama syndrome is an immune complex reaction to migrating schistosomules weeks after exposure to fresh water. Chronic schistosomiasis causes hepatic fibrosis or, with S. haematobium, bladder squamous carcinoma.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Trematodes",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_HEL_010",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Helminths: intestinal & tissue nematodes, cestodes, trematodes",
   "difficulty": "M",
   "stem": "Praziquantel acts by:",
   "options": [
    "Inhibiting tubulin",
    "Inhibiting protein synthesis",
    "Blocking folate synthesis",
    "Increasing membrane permeability to calcium causing tetanic contraction of the parasite"
   ],
   "correct": 3,
   "concept": "Calcium influx causes spastic paralysis and tegumental damage exposing parasite antigens to host immunity. It is the drug of choice for schistosomiasis, taeniasis, and neurocysticercosis alongside albendazole.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Anthelmintics",
   "tags": [
