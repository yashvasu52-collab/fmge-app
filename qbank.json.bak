   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Glomerular disease & nephrotic syndrome",
   "difficulty": "H",
   "stem": "A patient with hepatitis C, palpable purpura, arthralgia, low C4 and nephritic urine most likely has:",
   "options": [
    "Cryoglobulinaemic membranoproliferative glomerulonephritis",
    "Minimal change disease",
    "Amyloidosis",
    "Diabetic nephropathy"
   ],
   "correct": 0,
   "concept": "Cryoglobulins activate the classical pathway so C4 falls disproportionately, and treating the hepatitis C with direct-acting antivirals is the primary therapy.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 314 (Glomerular Diseases)",
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MED_GN_019",
   "part": "B",
   "subject": "Medicine",
