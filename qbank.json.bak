   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PED_CHD_009",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Congenital & rheumatic heart disease in children",
   "difficulty": "H",
   "stem": "The most frequently affected valve in chronic rheumatic heart disease is:",
   "options": [
    "Aortic valve",
    "Tricuspid valve",
    "Mitral valve",
    "Pulmonary valve"
   ],
   "correct": 2,
   "concept": "The mitral valve is involved in about 75% of cases, alone or with the aortic valve; mitral stenosis produces a loud first sound, opening snap and mid-diastolic murmur with a malar flush. The pulmonary valve is rarely affected.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. Rheumatic Fever",
   "tags": [
