  },
  {
   "id": "Q_MED_HIV_011",
   "part": "B",
   "subject": "Medicine",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "verified_on": "2026-09-01",
   "topic": "HIV/AIDS: staging, ART & opportunistic infections",
   "difficulty": "E",
   "stem": "A patient established on tenofovir, lamivudine and dolutegravir for nine months has a plasma HIV RNA of 800 copies/mL. The most appropriate next step is:",
   "options": [
    "Immediately switch to a second-line protease-inhibitor regimen",
    "Reinforce adherence and repeat the viral load after three months before declaring failure",
    "Add a fourth drug to the current regimen",
    "Stop all antiretroviral therapy and reassess in three months"
   ],
   "correct": 1,
   "concept": "Virological failure is defined as a plasma viral load above 1000 copies/mL on two consecutive measurements taken about three months apart, with adherence support in between. A single value between 50 and 1000 copies/mL is most often low-level viraemia or a blip from imperfect adherence, so switching regimens on one reading needlessly exhausts future options. Resistance testing guides any change that does prove necessary.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 202 (Human Immunodeficiency Virus Disease)",
   "verify_note": "rewritten because the original stem duplicated Q_MED_HIV_002 on when to start antiretroviral therapy (Jaccard 0.82); replaced with the definition of virological failure (plan 6.2)"
  },
  {
   "id": "Q_MED_HIV_012",
   "part": "B",
   "subject": "Medicine",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "HIV/AIDS: staging, ART & opportunistic infections",
   "difficulty": "E",
   "stem": "The preferred first-line antiretroviral regimen for adults in India is:",
   "options": [
    "Stavudine with lamivudine and efavirenz",
    "Zidovudine with lamivudine and nevirapine",
    "Tenofovir with lamivudine and dolutegravir",
    "Tenofovir with emtricitabine alone"
   ],
   "correct": 2,
   "concept": "Dolutegravir has a high genetic barrier to resistance, rapid viral suppression and few interactions, which is why it replaced efavirenz as the anchor drug.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 202 (Human Immunodeficiency Virus Disease)",
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MED_HIV_013",
   "part": "B",
   "subject": "Medicine",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "HIV/AIDS: staging, ART & opportunistic infections",
   "difficulty": "E",
   "stem": "Under current national guidelines, when is antiretroviral therapy started in a person newly diagnosed with HIV, and what is the usual first-line regimen?",
   "options": [
    "Immediately, regardless of CD4 count, using tenofovir with lamivudine and dolutegravir",
    "Only when the CD4 count falls below 350",
    "Only when an opportunistic infection occurs",
    "After 6 months of observation"
   ],
   "correct": 0,
   "concept": "Treat-all replaced CD4-based thresholds because early therapy reduces both progression and onward transmission, and the integrase-inhibitor-based regimen is preferred for its rapid viral suppression and high resistance barrier.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. Human Immunodeficiency Virus Disease",
   "verified_on": "2026-09-01",
   "verify_note": "duplicate of Q_MED_HIV_003, which asks the same CD4 threshold for cotrimoxazole prophylaxis. Rewritten to when antiretroviral therapy is started"
  },
