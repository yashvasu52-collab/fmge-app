   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Forensic psychiatry, general toxicology & autopsy technique",
   "difficulty": "M",
   "stem": "The Mental Healthcare Act 2017 is significant because it:",
   "options": [
    "Applies only to institutions",
    "Increases penalties for suicide",
    "Decriminalises attempted suicide and establishes advance directives and the right to treatment",
    "Removes patient rights"
   ],
   "correct": 2,
   "concept": "The Act presumes that a person attempting suicide has severe stress and shall not be punished under Section 309 IPC, mandates a duty of care, and empowers patients through advance directives and nominated representatives.",
   "reference": "Mental Healthcare Act 2017",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_NSA_002",
