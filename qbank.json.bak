  },
  {
   "id": "Q_BC_CAN_001",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "E",
   "stem": "An oncogene differs from a proto-oncogene in that it is:",
   "options": [
    "A normal gene",
    "A tumour suppressor",
    "Inactive",
    "An activated, gain-of-function form driving unregulated proliferation"
   ],
   "correct": 3,
   "concept": "A single activated allele suffices, making oncogenes dominant at the cellular level, whereas tumour suppressors require loss of both alleles - the Knudson two-hit hypothesis.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Cancer: An Overview",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "the chapter was cited as \"Cancer Biochemistry\", which is not the chapter title the rest of the topic uses"
