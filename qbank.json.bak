   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Zoonoses: rabies, plague, leptospirosis, brucellosis",
   "difficulty": "M",
   "stem": "A category II rabies exposure, defined as minor scratches without bleeding, requires:",
   "options": [
    "Vaccine and immunoglobulin",
    "Wound washing and vaccine, but not immunoglobulin",
    "Observation only",
    "Immunoglobulin only"
   ],
   "correct": 1,
   "concept": "Category I is touching or feeding with intact skin needing no prophylaxis; category III with transdermal bites, bleeding scratches or mucosal contamination requires immunoglobulin as well as vaccine.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Rabies",
   "tags": [
