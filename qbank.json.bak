  {
   "id": "Q_FM_ALC_004",
   "part": "A",
   "subject": "Forensic Medicine (FMT)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Alcohol, opioids, sedatives & drugs of abuse (medico-legal)",
   "difficulty": "E",
   "stem": "Under Section 85 of the Indian Penal Code, voluntary intoxication:",
   "options": [
    "Is not a defence to a criminal charge",
    "Is a complete defence",
    "Reduces all charges",
    "Is a defence only for minor offences"
   ],
   "correct": 0,
   "concept": "Only involuntary intoxication, where the substance was administered without knowledge or against will, may afford a defence by negating the capacity to form intent. Voluntary intoxication is not exculpatory.",
   "reference": "Reddy's The Essentials of Forensic Medicine and Toxicology 34e, Ch. Alcohol",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_FM_ALC_005",
   "part": "A",
   "subject": "Forensic Medicine (FMT)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Alcohol, opioids, sedatives & drugs of abuse (medico-legal)",
   "difficulty": "M",
   "stem": "The triad of opioid overdose is:",
   "options": [
    "Coma, dilated pupils and tachycardia",
    "Coma, pinpoint pupils and respiratory depression",
    "Agitation, sweating and hypertension",
    "Seizures, fever and rigidity"
   ],
   "correct": 1,
   "concept": "Naloxone reverses it dramatically and is both diagnostic and therapeutic, but its short half-life requires repeated doses or infusion since most opioids outlast it, risking re-sedation.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Opioid Analgesics",
   "tags": [
