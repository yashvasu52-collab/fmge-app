  {
   "id": "Q_PED_IEM_009",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Inborn errors, newborn screening & chromosomal syndromes",
   "difficulty": "H",
   "stem": "Prader-Willi and Angelman syndromes illustrate the principle of:",
   "options": [
    "Genomic imprinting, with the phenotype depending on the parental origin of the deleted 15q region",
    "Mitochondrial inheritance",
    "X-linked dominance",
    "Autosomal recessive inheritance"
   ],
   "correct": 0,
   "concept": "Deletion of paternal 15q11-13 causes Prader-Willi with hypotonia, hyperphagia, obesity and hypogonadism; the same maternal deletion causes Angelman with severe intellectual disability, ataxia and inappropriate laughter.",
   "reference": "Nelson Textbook of Pediatrics 21e, Ch. Imprinting Disorders",
   "tags": [
