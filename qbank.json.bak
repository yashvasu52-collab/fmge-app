   "id": "Q_GEN_ANAES_LA_007",
   "subject": "Anaesthesia",
   "topic": "Local anaesthetics (max doses, toxicity)",
   "part": "B",
   "difficulty": "E",
   "stem": "The maximum safe dose of PLAIN lignocaine (without adrenaline) for infiltration in an adult is approximately:",
   "options": [
    "1 mg/kg",
    "2 mg/kg",
    "3 mg/kg",
    "7 mg/kg"
   ],
