  {
   "id": "Q_MIC_RIC_008",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "H",
   "stem": "Q fever is distinctive among rickettsial diseases because it:",
   "options": [
    "Is never chronic",
    "Always has a rash",
    "Is acquired by inhalation, has no rash, and may cause culture-negative endocarditis",
    "Is louse-borne"
   ],
   "correct": 2,
   "concept": "Coxiella burnetii is highly infectious by aerosol, causing pneumonia and hepatitis without the rash typical of other rickettsioses, and chronic infection presents as culture-negative endocarditis.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Rickettsiae",
   "tags": [
