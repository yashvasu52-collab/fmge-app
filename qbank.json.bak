  {
   "id": "Q_PYQ_FMGE_2025JULP1_037",
   "subject": "Medicine",
   "topic": "COPD & asthma",
   "part": "B",
   "difficulty": "M",
   "stem": "A patient presents with 6 months of progressive shortness of breath and dry cough. Auscultation reveals bilateral basal end-inspiratory crepitations. There is no history of fever, joint pain or occupational exposure. What is the diagnosis?",
   "options": [
    "Cor-pulmonale",
    "Sarcoidosis",
    "IPF",
    "Hypersensitivity pneumonitis"
   ],
   "correct": 2,
