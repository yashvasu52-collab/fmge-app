   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cardiac output, regional circulations & exercise",
   "difficulty": "E",
   "stem": "Cardiac output is the product of:",
   "options": [
    "Contractility and pressure",
    "Stroke volume and heart rate",
    "Preload and afterload",
    "Blood pressure and resistance"
   ],
   "correct": 1,
   "concept": "Normal output is about 5 L/min. Cardiac index adjusts for body surface area, and the determinants of stroke volume are preload, afterload and contractility.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Circulation",
   "tags": [
