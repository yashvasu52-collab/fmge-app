  {
   "id": "Q_MIC_RIC_009",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "H",
   "stem": "Lymphogranuloma venereum characteristically shows:",
   "options": [
    "A transient painless ulcer followed by painful matted inguinal nodes with a groove sign",
    "Multiple painful ulcers",
    "Vesicles",
    "A single indurated painless ulcer"
   ],
   "correct": 0,
   "concept": "Buboes above and below the inguinal ligament are separated by the ligament producing the groove sign, and may rupture forming sinuses. Doxycycline for 21 days is the treatment.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Chlamydiae",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_RIC_010",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "M",
   "stem": "The drug of choice for all rickettsial infections is:",
   "options": [
    "Doxycycline",
    "Gentamicin",
    "Cotrimoxazole",
    "Penicillin"
   ],
   "correct": 0,
   "concept": "Doxycycline produces defervescence within 48 hours, and this therapeutic response is itself diagnostically useful. Azithromycin is used in pregnancy and young children; beta-lactams are ineffective.",
