  {
   "id": "Q_MIC_CLO_008",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Clostridia & anaerobes (tetanus, gas gangrene, botulism)",
   "difficulty": "H",
   "stem": "Bacteroides fragilis is clinically important because it is:",
   "options": [
    "The commonest anaerobe isolated from intra-abdominal sepsis, and is resistant to penicillin",
    "An aerobe",
    "A Gram-positive coccus",
    "Always penicillin sensitive"
   ],
   "correct": 0,
   "concept": "Bacteroides fragilis is a Gram-negative anaerobic bacillus of the colonic flora causing intra-abdominal and pelvic abscesses. It produces beta-lactamase, so metronidazole, carbapenems or beta-lactam-inhibitor combinations are used.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Anaerobic Bacteria",
   "tags": [
