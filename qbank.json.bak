  {
   "id": "Q_BC_CAN_003",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "M",
   "stem": "Telomerase is significant in cancer because it:",
   "options": [
    "Shortens telomeres",
    "Maintains telomere length, allowing unlimited replicative capacity",
    "Repairs DNA",
    "Degrades chromosomes"
   ],
   "correct": 1,
   "concept": "Normal somatic cells lose telomere length each division until replicative senescence. Most cancers reactivate telomerase, achieving immortality - one of the recognised hallmarks of cancer.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Cancer: An Overview",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "the chapter was cited as \"Cancer Biochemistry\", which is not the chapter title the rest of the topic uses"
  },
  {
   "id": "Q_BC_CAN_004",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "E",
   "stem": "Alpha-fetoprotein is a useful tumour marker for:",
   "options": [
    "Prostate carcinoma",
    "Colorectal carcinoma",
    "Hepatocellular carcinoma and non-seminomatous germ cell tumours",
    "Breast carcinoma"
   ],
   "correct": 2,
   "concept": "CEA is used for colorectal, PSA for prostate, CA-125 for ovarian and CA 19-9 for pancreatic cancer. Markers are best for monitoring treatment response and detecting recurrence, not for screening.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Cancer: An Overview",
