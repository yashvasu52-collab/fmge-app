   "verified_by": "model-audit",
   "topic": "Medical disorders in pregnancy: anaemia, diabetes, heart disease",
   "difficulty": "M",
   "stem": "Parenteral iron in pregnancy is indicated when:",
   "options": [
    "Haemoglobin is 11 g/dL",
    "Oral iron is not tolerated or absorbed, or anaemia is moderate with insufficient time before delivery",
    "Only after delivery",
    "In the first trimester routinely"
   ],
   "correct": 1,
   "concept": "Intravenous iron sucrose or ferric carboxymaltose is used for intolerance or failure of oral iron, malabsorption, or moderate anaemia after the first trimester when there is too little time to correct by mouth. Blood transfusion is reserved for severe decompensated anaemia near term.",
   "reference": "FOGSI-ICOG Good Clinical Practice Recommendations on Iron Deficiency Anaemia in Pregnancy 2016; DC Dutta's Textbook of Obstetrics 9e, Ch. Medical Disorders in Pregnancy",
