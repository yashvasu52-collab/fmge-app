   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "M",
   "stem": "Quorum sensing in bacteria refers to:",
   "options": [
    "Flagellar movement",
    "Spore formation",
    "Capsule synthesis",
    "Density-dependent regulation of gene expression through signalling molecules"
   ],
   "correct": 3,
   "concept": "Bacteria secrete autoinducers whose concentration reflects population density, coordinating expression of virulence factors and biofilm formation once a threshold is reached - a target for novel anti-virulence therapies.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Bacterial Physiology",
