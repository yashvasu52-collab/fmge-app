  },
  {
   "id": "Q_OBG_MUL_007",
   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Multiple pregnancy, polyhydramnios & IUGR",
   "difficulty": "E",
   "stem": "Potter syndrome results from:",
   "options": [
    "Twin pregnancy",
    "Severe oligohydramnios causing pulmonary hypoplasia and limb deformity",
    "Polyhydramnios",
    "Maternal diabetes"
   ],
   "correct": 1,
   "concept": "Prolonged severe oligohydramnios, classically from bilateral renal agenesis, produces pulmonary hypoplasia, a flattened facies, low-set ears and positional limb deformities. Pulmonary hypoplasia is the fatal element.",
   "reference": "Nelson Textbook of Pediatrics 21e, Ch. Renal Agenesis",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_OBG_MUL_009",
   "part": "B",
