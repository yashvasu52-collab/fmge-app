  {
   "id": "Q_PSM_PLN_007",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Health planning, committees & health policy",
   "difficulty": "E",
   "stem": "Health planning in India is now guided by:",
   "options": [
    "NITI Aayog, which replaced the Planning Commission in 2015",
    "The Planning Commission",
    "The Finance Ministry alone",
    "State governments alone"
   ],
   "correct": 0,
   "concept": "Health is a state subject under the Constitution, with the centre providing policy direction and funding, making centre-state coordination essential for programme implementation.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Health Planning",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
