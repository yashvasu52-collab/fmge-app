  {
   "id": "Q_PH_DIU_002",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diuretics & drugs acting on the kidney",
   "difficulty": "M",
   "stem": "Thiazide diuretics characteristically cause:",
   "options": [
    "Hypercalciuria",
    "Hypokalaemia, hyponatraemia, hyperuricaemia, hyperglycaemia and hyperlipidaemia",
    "Hyperkalaemia",
    "Hypouricaemia"
   ],
   "correct": 1,
   "concept": "Thiazides reduce urinary calcium, making them useful in recurrent calcium stones and osteoporosis, but raise urate, glucose and lipids. Loop diuretics conversely increase calcium excretion.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Diuretics",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_DIU_003",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diuretics & drugs acting on the kidney",
   "difficulty": "M",
   "stem": "Spironolactone is a:",
   "options": [
    "Loop diuretic",
    "Competitive aldosterone antagonist causing potassium retention and gynaecomastia",
    "Osmotic diuretic",
    "Carbonic anhydrase inhibitor"
   ],
   "correct": 1,
   "concept": "Spironolactone is used in heart failure, ascites of cirrhosis, primary hyperaldosteronism and resistant hypertension. Gynaecomastia and menstrual irregularity result from antiandrogenic action; eplerenone is more selective.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Diuretics",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_DIU_004",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diuretics & drugs acting on the kidney",
   "difficulty": "E",
   "stem": "Mannitol is contraindicated in:",
   "options": [
    "Raised intracranial pressure",
    "Cerebral oedema",
    "Glaucoma",
    "Acute pulmonary oedema and established anuria"
   ],
   "correct": 3,
   "concept": "An osmotic diuretic expands intravascular volume before diuresis, precipitating pulmonary oedema in cardiac failure. It is filtered but not reabsorbed, and is ineffective if the kidneys are not producing urine.",
