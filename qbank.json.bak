   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Contraception",
   "difficulty": "M",
   "stem": "After medical abortion at 8 weeks, when can a combined oral contraceptive pill be started?",
   "options": [
