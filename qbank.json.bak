  },
  {
   "id": "Q_MIC_RIC_001",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "E",
   "stem": "Rickettsiae are transmitted to humans principally by:",
   "options": [
    "Sexual contact",
    "Contaminated water",
    "Respiratory droplets",
    "Arthropod vectors such as ticks, mites, lice and fleas"
   ],
   "correct": 3,
   "concept": "All rickettsial infections except Q fever are arthropod-borne obligate intracellular organisms. Q fever from Coxiella burnetii is acquired by inhaling aerosols from infected animal birth products.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Rickettsiae",
   "tags": [
