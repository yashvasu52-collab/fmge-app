   "verified_by": "model-audit",
   "topic": "Reproductive physiology, pregnancy & lactation",
   "difficulty": "H",
   "stem": "Testosterone is converted in target tissues to:",
   "options": [
    "Only DHT",
    "Dihydrotestosterone by 5-alpha-reductase and to oestradiol by aromatase",
    "Cortisol",
    "Only oestradiol"
   ],
