  {
   "id": "Q_PAT_MDS_002",
   "part": "A",
   "subject": "Pathology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Myelodysplasia, marrow failure & transfusion medicine",
   "difficulty": "M",
   "stem": "Ring sideroblasts are demonstrated by which stain?",
   "options": [
    "Ziehl-Neelsen",
    "Congo red",
    "Perls Prussian blue",
    "Periodic acid-Schiff"
   ],
   "correct": 2,
   "concept": "Perls stain shows iron-laden mitochondria encircling the nucleus of erythroid precursors. Ring sideroblasts occur in MDS with ring sideroblasts, lead poisoning, alcohol excess, isoniazid therapy and pyridoxine deficiency.",
   "reference": "Robbins & Cotran Pathologic Basis of Disease 10e, Ch. Red Blood Cell Disorders",
   "tags": [
    "#high-yield",
