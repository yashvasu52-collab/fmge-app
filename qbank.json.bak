  {
   "id": "Q_MIC_STR_009",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "H",
   "stem": "The minimum inhibitory concentration is defined as:",
   "options": [
    "The peak serum level",
    "The lowest antibiotic concentration that prevents visible bacterial growth",
    "The dose administered",
    "The concentration that kills 99.9 percent"
   ],
   "correct": 1,
   "concept": "MIC defines susceptibility, while the minimum bactericidal concentration is the lowest concentration killing 99.9% of the inoculum. When MBC greatly exceeds MIC the organism is tolerant.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Antimicrobial Susceptibility",
   "tags": [
