  {
   "id": "Q_GEN_ANAES_LA_009",
   "subject": "Anaesthesia",
   "topic": "Local anaesthetics (max doses, toxicity)",
   "part": "B",
   "difficulty": "E",
   "stem": "Adrenaline is commonly added to a local anaesthetic solution mainly to:",
   "options": [
    "Increase the pH and hasten onset",
    "Lower the pKa of the drug",
    "Provide additional analgesia by a central action",
    "Cause local vasoconstriction, prolonging the block and reducing systemic absorption"
   ],
   "correct": 3,
   "concept": "Adrenaline produces local vasoconstriction, which slows systemic absorption of the local anaesthetic. This prolongs the duration of the block, lowers the peak plasma concentration (reducing systemic toxicity), permits use of a larger total dose and reduces surgical bleeding in the field. A sudden tachycardia after injection can also act as an early marker of accidental intravascular placement. It does not raise pH, alter pKa, or provide any central analgesic effect.",
   "reference": "Morgan & Mikhail's Clinical Anesthesiology 6e, Ch. Local Anesthetics (Additives)",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
