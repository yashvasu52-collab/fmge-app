  {
   "id": "Q_MIC_SPC_001",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Specimen collection, serology & molecular diagnostics",
   "difficulty": "E",
   "stem": "Blood cultures for suspected bacteraemia should ideally be collected:",
   "options": [
    "After the first antibiotic dose",
    "From a single site only",
    "From an indwelling line only",
    "Before starting antibiotics, from two or three separate sites"
   ],
   "correct": 3,
   "concept": "Prior antibiotics markedly reduce yield, and multiple sets from separate venepunctures distinguish true bacteraemia from skin contaminants. Adequate blood volume is the single most important determinant of sensitivity.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Laboratory Diagnosis",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
