   "verified_by": "model-audit",
   "topic": "Abortion, ectopic pregnancy, recurrent pregnancy loss",
   "difficulty": "E",
   "stem": "A woman with an intrauterine pregnancy of 10 weeks by dates has an ultrasound showing a gestational sac of 30 mm with no embryo. This indicates:",
   "options": [
    "Pseudogestational sac of ectopic pregnancy",
    "Threatened abortion",
    "Complete molar pregnancy",
    "Anembryonic pregnancy (blighted ovum)"
   ],
   "correct": 3,
   "concept": "A mean sac diameter of 25 mm or more with no embryo meets the criterion for early pregnancy failure, and medical or surgical evacuation is then offered.",
   "reference": "DC Dutta's Textbook of Obstetrics 9e, Ch. Abortion and Ectopic Pregnancy",
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_OBG_AEP_003",
