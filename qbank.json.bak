  {
   "id": "Q_ENT_VER_006",
   "part": "B",
   "subject": "ENT",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "M",
   "stem": "Facial palsy with vesicles in the external auditory canal and severe otalgia indicates:",
   "options": [
    "Bell palsy",
    "Otitis externa",
    "Acoustic neuroma",
    "Ramsay Hunt syndrome from varicella zoster reactivation in the geniculate ganglion"
   ],
   "correct": 3,
   "concept": "Herpes zoster oticus causes painful vesicles in the concha and canal with facial palsy, often with sensorineural deafness and vertigo, and has a poorer recovery than Bell palsy. Treatment is acyclovir with steroids.",
