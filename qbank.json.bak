   "verified_by": "model-audit",
   "topic": "Haemodynamics: oedema, thrombosis, embolism, infarction, shock",
   "difficulty": "M",
   "stem": "Nutmeg liver on gross examination indicates:",
   "options": [
    "Fatty liver",
    "Chronic passive venous congestion of the liver from right heart failure",
    "Hepatitis",
    "Cirrhosis"
   ],
   "correct": 1,
   "concept": "Centrilobular congestion and necrosis alternating with paler peripheral fatty zones produce the mottled nutmeg appearance. Long-standing congestion may progress to cardiac sclerosis.",
   "reference": "Robbins & Cotran Pathologic Basis of Disease 10e, Ch. Haemodynamic Disorders",
