  },
  {
   "id": "Q_MIC_CLO_009",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Clostridia & anaerobes (tetanus, gas gangrene, botulism)",
   "difficulty": "H",
   "stem": "The most reliable clinical feature distinguishing tetanus from strychnine poisoning is:",
   "options": [
    "Persistent trismus with sustained rigidity between spasms in tetanus",
    "Presence of spasms",
    "Opisthotonus",
    "Preserved consciousness"
   ],
   "correct": 0,
   "concept": "In tetanus muscles remain rigid between spasms and trismus is characteristic, whereas in strychnine poisoning the patient relaxes completely between convulsions. Both preserve consciousness, which is a cruel feature of tetanus.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Clostridium",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_CLO_010",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Clostridia & anaerobes (tetanus, gas gangrene, botulism)",
   "difficulty": "M",
   "stem": "Anaerobic infections are typically suspected when there is:",
   "options": [
    "Foul-smelling discharge with gas in tissues and failure to grow on aerobic culture",
    "Neutropenia only",
    "Watery odourless discharge",
    "Rapid aerobic growth"
   ],
   "correct": 0,
   "concept": "Putrid odour from short-chain fatty acids, gas in tissues, necrosis, proximity to mucosal surfaces and sterile pus on routine culture all suggest anaerobes, requiring special transport media and anaerobic culture.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Anaerobic Bacteria",
   "tags": [
