   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Immunosuppressants, biologicals, vitamins & chelators",
   "difficulty": "M",
   "stem": "Azathioprine dose must be reduced when given with allopurinol because:",
   "options": [
    "It increases excretion",
    "It is inactivated",
    "Xanthine oxidase inhibition prevents metabolism of its active metabolite, causing marrow suppression",
    "It blocks absorption"
   ],
   "correct": 2,
   "concept": "Azathioprine is converted to 6-mercaptopurine which is degraded by xanthine oxidase; blocking this enzyme leads to accumulation and severe myelosuppression, so the dose is cut to about a quarter.",
