  {
   "id": "Q_PH_NSA_003",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "M",
   "stem": "Selective COX-2 inhibitors were developed to reduce gastric toxicity, but are limited by:",
   "options": [
    "Hepatotoxicity",
    "Nephrotoxicity only",
    "Bone marrow suppression",
    "Increased cardiovascular thrombotic risk"
   ],
   "correct": 3,
   "concept": "Sparing COX-1 preserves gastric prostaglandins but reduces endothelial prostacyclin without inhibiting platelet thromboxane, shifting the balance towards thrombosis - which led to withdrawal of rofecoxib.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. NSAIDs",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_NSA_004",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "E",
   "stem": "Paracetamol differs from other NSAIDs in that it:",
   "options": [
    "Is the most potent anti-inflammatory",
    "Causes gastric ulcers",
    "Is an antiplatelet",
    "Has negligible anti-inflammatory and antiplatelet action"
   ],
   "correct": 3,
   "concept": "Paracetamol is a good analgesic and antipyretic acting centrally with little peripheral COX inhibition, making it safe in peptic ulcer, asthma and bleeding disorders, but useless for inflammatory arthritis.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Analgesic-Antipyretics",
   "tags": [
