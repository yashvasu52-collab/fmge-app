   "verified_by": "model-audit",
   "topic": "Innate & adaptive immunity, antigen-antibody reactions, vaccines",
   "difficulty": "E",
   "stem": "Passive immunisation with immunoglobulin provides:",
   "options": [
    "Immediate but temporary protection without immunological memory",
    "Herd immunity",
    "Memory cells",
    "Long-lasting immunity"
   ],
   "correct": 0,
   "concept": "Preformed antibody acts at once but wanes over weeks, and is used post-exposure for rabies, tetanus, hepatitis B and diphtheria alongside active immunisation, which provides durable memory but takes time.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Immunity",
