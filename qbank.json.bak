   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cardiac output, regional circulations & exercise",
   "difficulty": "M",
   "stem": "Cardiac output is measured by the Fick principle using:",
   "options": [
    "Ejection fraction",
    "Blood pressure and heart rate",
    "Stroke volume alone",
    "Oxygen consumption divided by the arteriovenous oxygen difference"
   ],
   "correct": 3,
   "concept": "Thermodilution using a pulmonary artery catheter and echocardiographic methods are the practical clinical alternatives, with echocardiography now predominant because it is non-invasive.",
