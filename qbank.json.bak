  {
   "id": "Q_ENT_VER_002",
   "part": "B",
   "subject": "ENT",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "M",
   "stem": "Benign paroxysmal positional vertigo is diagnosed by:",
   "options": [
    "Pure tone audiometry",
    "The Dix-Hallpike test provoking rotatory nystagmus with a latent period and fatigability",
    "Caloric test only",
    "Weber test"
   ],
   "correct": 1,
   "concept": "BPPV is due to canalolithiasis of the posterior semicircular canal. A positive Dix-Hallpike shows brief rotatory nystagmus with 2 to 20 second latency that fatigues on repetition, and is treated by the Epley repositioning manoeuvre.",
   "reference": "Dhingra Diseases of Ear, Nose and Throat 8e, Ch. Vertigo",
   "tags": [
    "#high-yield",
