   "id": "Q_GEN_RADIO_SAFETY_001",
   "subject": "Radiology",
   "topic": "Radiation safety & principles",
   "part": "B",
   "difficulty": "E",
   "stem": "The SI unit of absorbed dose, defined as one joule of energy deposited per kilogram of tissue, is the:",
   "options": [
    "Sievert",
    "Gray",
    "Becquerel",
    "Coulomb per kilogram"
   ],
   "correct": 1,
   "concept": "The gray (Gy) is the SI unit of absorbed dose, defined as one joule of energy deposited per kilogram of tissue (1 Gy = 1 J/kg). It replaced the older rad (1 Gy = 100 rad). It quantifies energy deposition irrespective of radiation type; biological weighting is applied only when converting to equivalent dose in sieverts, and it must not be confused with the becquerel (activity).",
   "reference": "Christensen's Physics of Diagnostic Radiology / ICRP recommendations, Ch. Dosimetric Quantities",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
