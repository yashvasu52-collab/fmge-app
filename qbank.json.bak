   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "A 40-year-old with a family history of a similar illness has choreiform movements, irritability and progressive cognitive decline. What is the diagnosis and the mode of inheritance?",
   "options": [
    "Multiple sclerosis, multifactorial",
    "Wilson disease, autosomal recessive",
    "Sydenham chorea, not inherited",
    "Huntington disease, autosomal dominant with a CAG trinucleotide repeat expansion"
   ],
   "correct": 3,
   "concept": "Psychiatric symptoms including depression and personality change frequently precede the movement disorder, and the suicide risk is high, so genetic counselling and psychiatric support are as important as symptomatic treatment.",
   "reference": "Ahuja A Short Textbook of Psychiatry 8e, Ch. Organic Mental Disorders",
   "verified_on": "2026-09-01"
  },
