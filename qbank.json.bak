  {
   "id": "Q_GEN_FMT_ASPHYXIA_013",
   "subject": "Forensic Medicine (FMT)",
   "topic": "Asphyxial deaths (hanging, drowning)",
   "part": "A",
   "difficulty": "M",
   "stem": "During a robbery a cloth is forced into and tied across the victim's mouth; the victim is later found dead with the sodden cloth still in place. The asphyxial mechanism is best termed:",
   "options": [
    "Choking",
    "Café coronary",
    "Overlaying",
