  },
  {
   "id": "Q_AN_MR_007",
   "part": "B",
   "subject": "Anaesthesia",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Muscle relaxants, monitoring, anaesthesia machine & breathing circuits",
   "difficulty": "E",
   "stem": "Capnography during anaesthesia is the most reliable monitor for confirming:",
   "options": [
    "Correct tracheal placement of the endotracheal tube",
    "Depth of anaesthesia",
    "Blood loss",
    "Muscle relaxation"
   ],
   "correct": 0,
   "concept": "A sustained end-tidal carbon dioxide waveform over several breaths confirms tracheal rather than oesophageal intubation. A sudden fall suggests disconnection, cardiac arrest or pulmonary embolism.",
   "reference": "Morgan & Mikhail's Clinical Anesthesiology 6e, Ch. Patient Monitors",
   "tags": [
