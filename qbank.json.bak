   "verified_by": "model-audit",
   "topic": "Glomerular disease & nephrotic syndrome",
   "difficulty": "E",
   "stem": "A child with generalised oedema, proteinuria of 4 g per day, albumin 1.8 g/dL and normal complement most likely has:",
   "options": [
    "Membranous nephropathy",
    "Post-streptococcal glomerulonephritis",
    "IgA nephropathy",
    "Minimal change disease"
   ],
   "correct": 3,
   "concept": "Minimal change disease accounts for most childhood nephrotic syndrome, shows only podocyte foot process effacement on electron microscopy and responds to corticosteroids without needing a biopsy first.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 314 (Glomerular Diseases)",
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a concept-similarity duplicate candidate; answer, topic and reference confirmed"
  },
  {
   "id": "Q_MED_GN_014",
   "part": "B",
