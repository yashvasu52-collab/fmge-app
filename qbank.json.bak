   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "E",
   "stem": "The bacterial growth curve phase in which cells are most susceptible to antibiotics is:",
   "options": [
    "The lag phase",
    "The decline phase",
    "The stationary phase",
    "The log (exponential) phase"
   ],
   "correct": 3,
   "concept": "Actively dividing cells in log phase are most vulnerable, particularly to cell wall active agents which require ongoing peptidoglycan synthesis. This is why beta-lactams are ineffective against dormant persisters.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Morphology and Physiology of Bacteria",
