  {
   "id": "Q_PY_LNG_007",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Lung volumes, compliance, V/Q & mechanics of breathing",
   "difficulty": "E",
   "stem": "The main muscle of quiet inspiration is:",
   "options": [
    "External intercostals",
    "Scalenes",
    "The diaphragm, accounting for about 75 percent of tidal volume",
    "Abdominal muscles"
   ],
   "correct": 2,
   "concept": "Quiet expiration is passive, driven by elastic recoil. Accessory muscles - sternocleidomastoid, scalenes and abdominals - are recruited in exercise and respiratory distress, and their use is a clinical sign of severity.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Respiration",
   "tags": [
