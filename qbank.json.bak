  {
   "id": "Q_OR_UL_002",
   "part": "B",
   "subject": "Orthopedics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Upper limb injuries: shoulder, humerus, elbow, wrist",
   "difficulty": "M",
   "stem": "Posterior shoulder dislocation is classically associated with:",
   "options": [
    "Direct trauma",
    "Epileptic seizures and electric shock",
    "Falls on outstretched hand",
    "Overhead activity"
   ],
   "correct": 1,
   "concept": "Violent internal rotator contraction during a seizure or shock drives the head posteriorly. It is frequently missed on an anteroposterior film, showing a light-bulb sign; an axillary or scapular Y view is essential.",
   "reference": "Maheshwari Essential Orthopaedics 6e, Ch. Upper Limb Injuries",
   "tags": [
