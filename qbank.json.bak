  },
  {
   "id": "Q_PSM_INT_005",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "International health, WHO, SDGs & disaster management",
   "difficulty": "M",
   "stem": "In disaster management, triage aims to:",
   "options": [
    "Treat children first",
    "Treat the most severely injured first regardless of prognosis",
    "Treat in order of arrival",
    "Do the greatest good for the greatest number by prioritising the salvageable"
   ],
   "correct": 3,
   "concept": "This inverts everyday clinical ethics: those with catastrophic unsurvivable injuries are given expectant care so resources go to those who can be saved - the essence of mass casualty triage.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Disaster Management",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_INT_006",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "International health, WHO, SDGs & disaster management",
   "difficulty": "M",
   "stem": "In the START triage system, the red (immediate) category indicates:",
   "options": [
    "Life-threatening injury that is treatable with immediate intervention",
    "Minor injury",
    "Dead or unsalvageable",
    "Delayed treatment acceptable"
   ],
   "correct": 0,
   "concept": "Green denotes walking wounded, yellow delayed, red immediate and black dead or expectant. Rapid reassessment is essential as casualties can deteriorate between categories.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Disaster Management",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_INT_007",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "International health, WHO, SDGs & disaster management",
   "difficulty": "E",
   "stem": "The commonest cause of death in the immediate aftermath of an earthquake is:",
   "options": [
    "Starvation",
    "Epidemic disease",
    "Crush injury and trauma",
    "Exposure"
   ],
   "correct": 2,
   "concept": "Epidemics do not arise spontaneously from dead bodies - a persistent myth. Disease risk comes later from displacement, overcrowding and disruption of water and sanitation.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Disaster Management",
   "tags": [
