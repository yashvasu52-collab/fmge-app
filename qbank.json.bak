  {
   "id": "Q_FM_ALC_010",
   "part": "A",
   "subject": "Forensic Medicine (FMT)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Alcohol, opioids, sedatives & drugs of abuse (medico-legal)",
   "difficulty": "M",
   "stem": "Delirium tremens in a hospitalised patient is best treated with:",
   "options": [
    "Alcohol administration",
    "Benzodiazepines with thiamine and supportive care",
    "Physical restraint alone",
    "Antipsychotics alone"
   ],
   "correct": 1,
   "concept": "Benzodiazepines are cross-tolerant with alcohol and prevent seizures and death; parenteral thiamine must precede glucose to avoid precipitating Wernicke encephalopathy. Antipsychotics lower the seizure threshold.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Alcohol",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
