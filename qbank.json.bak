  },
  {
   "id": "Q_PSM_DIA_001",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diarrhoeal disease, enteric fever, hepatitis & helminths",
   "difficulty": "E",
   "stem": "Cholera is characterised by:",
   "options": [
    "Bloody diarrhoea with fever",
    "Painless profuse rice-watery stools with rapid dehydration and no fever",
    "Gradual onset",
    "Constipation"
   ],
   "correct": 1,
   "concept": "Vibrio cholerae toxin irreversibly activates adenylate cyclase, causing massive secretory diarrhoea. Death is from hypovolaemic shock within hours, so rapid rehydration is life-saving.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Cholera",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_DIA_002",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diarrhoeal disease, enteric fever, hepatitis & helminths",
   "difficulty": "M",
   "stem": "In a cholera outbreak, the single most important intervention is:",
   "options": [
    "Prompt rehydration of cases with ORS and intravenous fluids",
    "Mass antibiotic prophylaxis",
    "Mass vaccination",
    "Quarantine"
   ],
   "correct": 0,
   "concept": "Rehydration reduces case fatality from over 30% to under 1%. Antibiotics shorten shedding but are secondary, and quarantine is ineffective and not recommended.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Cholera",
   "tags": [
    "#high-yield",
    "#DoC"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_DIA_003",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Diarrhoeal disease, enteric fever, hepatitis & helminths",
   "difficulty": "M",
   "stem": "Typhoid fever is confirmed most reliably in the first week by:",
   "options": [
    "Widal test",
    "Blood culture",
    "Stool culture",
    "Urine culture"
   ],
   "correct": 1,
   "concept": "Blood culture is positive in about 80% in week one, bone marrow culture has the highest yield throughout, and stool and urine cultures become positive in weeks two and three.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Enteric Fever",
   "tags": [
    "#high-yield",
