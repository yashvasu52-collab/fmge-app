  {
   "id": "Q_PAT_MDS_010",
   "part": "A",
   "subject": "Pathology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Myelodysplasia, marrow failure & transfusion medicine",
   "difficulty": "M",
   "stem": "The window period in blood donor screening refers to:",
   "options": [
    "The time to cross-match",
    "The shelf life of blood",
    "The interval between donations",
    "The interval after infection when the donor is infectious but screening tests remain negative"
   ],
   "correct": 3,
   "concept": "Nucleic acid testing shortens the window period substantially compared with antibody testing, reducing but not abolishing residual transfusion transmission risk - which is why unnecessary transfusion is itself a hazard.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Blood Transfusion Services",
   "tags": [
