  {
   "id": "Q_MIC_ARB_007",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Arboviruses: dengue, chikungunya, JE, Zika",
   "difficulty": "E",
   "stem": "The mainstay of dengue management is:",
   "options": [
    "Careful isotonic crystalloid fluid therapy guided by haematocrit and vital signs",
    "Antiviral therapy",
    "Corticosteroids",
    "Platelet transfusion for all"
   ],
   "correct": 0,
   "concept": "There is no specific antiviral; judicious fluid replacement during the critical phase of plasma leakage prevents shock, while excess fluid causes overload. Platelets are transfused only for significant bleeding, not for a low count alone.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Dengue",
