  {
   "id": "Q_GEN_FMT_THANATOLOGY_003",
   "subject": "Forensic Medicine (FMT)",
   "topic": "Death, postmortem changes (rigor/livor/algor)",
   "part": "A",
   "difficulty": "H",
   "stem": "A ventilated patient in an intensive care unit is being assessed for brainstem death. Which one of the following findings is COMPATIBLE with the diagnosis and does NOT exclude it?",
   "options": [
    "A brisk pupillary reaction to light",
    "Spontaneous respiratory effort during the apnoea test",
    "An intact corneal reflex on both sides",
    "Preserved spinal reflexes such as a deep tendon jerk"
   ],
   "correct": 3,
   "concept": "Brainstem death requires demonstrable, irreversible loss of all brainstem functions: fixed non-reacting pupils and absent corneal, oculocephalic, oculovestibular, gag and cough reflexes, with no respiratory drive on a formal apnoea test. Spinal-cord-mediated reflexes (deep tendon jerks, limb withdrawal, the Lazarus sign) may persist because the cord is still perfused, and their presence does NOT exclude brainstem death. A reacting pupil, an intact corneal reflex, or spontaneous respiration would each refute the diagnosis.",
   "reference": "Reddy's The Essentials of Forensic Medicine and Toxicology 34e, Ch. Death and Brainstem Death",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
   "verified_on": "2026-09-01"
  },
