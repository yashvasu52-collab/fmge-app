  },
  {
   "id": "Q_PSM_CHI_008",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Child health programmes, IMNCI & school health",
   "difficulty": "H",
   "stem": "Under Rashtriya Bal Swasthya Karyakram, children are screened for the 4 Ds, which are:",
   "options": [
    "Diarrhoea, Dysentery, Dengue, Diphtheria",
    "Deficiency, Dysentery, Delay, Diabetes",
    "Diabetes, Deafness, Dental, Dermatitis",
    "Defects at birth, Deficiencies, Diseases and Developmental delays including disability"
   ],
   "correct": 3,
   "concept": "Screening covers children from birth to 18 years through facilities, anganwadis and schools, with referral to District Early Intervention Centres for confirmed conditions.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Child Health",
   "tags": [
    "#high-yield"
   ],
