  {
   "id": "Q_PS_SOM_010",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Somatoform, dissociative, personality & sexual disorders",
   "difficulty": "M",
   "stem": "Erectile dysfunction of psychogenic origin is suggested by:",
   "options": [
    "Onset after prostatectomy",
    "Gradual loss of all erections",
    "Absent morning erections",
    "Preserved nocturnal and early morning erections with abrupt situational onset"
   ],
   "correct": 3,
   "concept": "Preserved spontaneous nocturnal erections indicate intact neurovascular mechanisms, pointing to psychogenic causes, whereas organic dysfunction from diabetes, vascular disease or drugs causes gradual global loss.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Sexual Dysfunctions",
   "tags": [
