  {
   "id": "Q_PSM_CON_002",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Concepts of health & disease, natural history, levels of prevention",
   "difficulty": "M",
   "stem": "Primordial prevention is best exemplified by:",
   "options": [
    "Early diagnosis by screening",
    "Rehabilitation",
    "Disability limitation",
    "Preventing the emergence of risk factors in a population that has not yet acquired them"
   ],
   "correct": 3,
   "concept": "Primordial prevention discourages adoption of harmful lifestyles - for instance national policy discouraging tobacco or promoting healthy diet in children - acting before risk factors appear, unlike primary prevention which acts on existing risk factors.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Concept of Prevention",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_CON_003",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Concepts of health & disease, natural history, levels of prevention",
   "difficulty": "M",
   "stem": "Specific protection such as immunisation is a form of:",
   "options": [
    "Primary prevention",
    "Secondary prevention",
    "Primordial prevention",
    "Tertiary prevention"
   ],
   "correct": 0,
   "concept": "Primary prevention comprises health promotion and specific protection, applied in the pre-pathogenesis phase. Secondary prevention is early diagnosis and treatment during pathogenesis, and tertiary prevention is disability limitation and rehabilitation.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Concept of Prevention",
   "tags": [
