  {
   "id": "Q_PSM_CON_008",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Concepts of health & disease, natural history, levels of prevention",
   "difficulty": "H",
   "stem": "The Sullivan index measures:",
   "options": [
    "Crude death rate",
    "Expectation of life free of disability",
    "Maternal mortality",
    "Infant mortality"
   ],
   "correct": 1,
   "concept": "Sullivan's index subtracts probable duration of disability from life expectancy, giving disability-free life expectancy. HALE, DALY and QALY are related composite measures combining mortality with morbidity.",
