  },
  {
   "id": "Q_PED_EMG_003",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Paediatric emergencies, poisoning & IMNCI",
   "difficulty": "M",
   "stem": "The most reliable single sign of shock in a child is:",
   "options": [
    "Hypotension",
    "Bradycardia",
    "Prolonged capillary refill with tachycardia, as hypotension is a late sign",
    "Fever"
   ],
   "correct": 2,
   "concept": "Children maintain blood pressure by intense vasoconstriction until late, so tachycardia, prolonged capillary refill, cool peripheries and altered mentation appear first. Hypotension signals decompensation and imminent arrest.",
   "reference": "American Heart Association Guidelines for Cardiopulmonary Resuscitation and Emergency Cardiovascular Care 2020, Pediatric Advanced Life Support; OP Ghai Essential Pediatrics 9e, Ch. Pediatric Emergencies",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "the reference read \"AHA PALS Guidelines\" with no year or supporting textbook"
  },
  {
   "id": "Q_PED_EMG_004",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Paediatric emergencies, poisoning & IMNCI",
   "difficulty": "E",
   "stem": "The initial fluid bolus for a child in hypovolaemic shock is:",
   "options": [
    "20 mL/kg of isotonic crystalloid",
    "5 mL/kg of dextrose",
    "50 mL/kg of colloid",
    "10 mL/kg of half-normal saline"
   ],
   "correct": 0,
   "concept": "Rapid boluses of 20 mL/kg normal saline or Ringer lactate are given and repeated with reassessment, though smaller 10 mL/kg boluses are used in severe malnutrition and cardiogenic shock to avoid overload.",
   "reference": "OP Ghai Essential Pediatrics 9e, Ch. Shock",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PED_EMG_007",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Paediatric emergencies, poisoning & IMNCI",
   "difficulty": "E",
   "stem": "The commonest cause of accidental death in Indian children aged 1 to 4 years is:",
   "options": [
    "Burns",
    "Poisoning",
    "Drowning and road traffic injuries",
    "Falls"
   ],
   "correct": 2,
   "concept": "Unintentional injury - drowning, road traffic injury, burns, falls and poisoning - is a leading cause of childhood death beyond infancy, and is addressed by supervision, home safety, helmets and child restraints.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Accidents",
   "tags": [
