  },
  {
   "id": "Q_PH_NSA_005",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "M",
   "stem": "Hepatotoxicity in paracetamol overdose is caused by:",
   "options": [
    "Immune reaction",
    "Renal metabolites",
    "Accumulation of NAPQI once glutathione stores are depleted",
    "The parent drug directly"
   ],
   "correct": 2,
   "concept": "CYP2E1 generates the reactive metabolite NAPQI, normally detoxified by glutathione. N-acetylcysteine replenishes glutathione, and chronic alcohol use and malnutrition increase susceptibility.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Analgesic-Antipyretics",
   "tags": [
