  {
   "id": "Q_PY_LNG_008",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Lung volumes, compliance, V/Q & mechanics of breathing",
   "difficulty": "H",
   "stem": "Compliance of the lung is reduced in:",
   "options": [
    "Emphysema",
    "Normal ageing",
    "Pulmonary fibrosis and pulmonary oedema",
    "Asthma"
   ],
   "correct": 2,
   "concept": "Restrictive disease stiffens the lung requiring greater pressure for a given volume change. Emphysema destroys elastic tissue increasing compliance but reducing recoil, causing air trapping.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Respiration",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PY_LNG_009",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Lung volumes, compliance, V/Q & mechanics of breathing",
   "difficulty": "H",
   "stem": "The Hering-Breuer inflation reflex:",
   "options": [
    "Operates during quiet breathing in adults",
    "Is mediated by the phrenic nerve",
    "Limits excessive lung inflation via vagal stretch receptors, important in newborns",
    "Increases inspiration"
   ],
   "correct": 2,
   "concept": "It is largely inactive during quiet adult breathing, becoming important at tidal volumes above about 1 litre and in the newborn, protecting against overdistension.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Respiration",
   "tags": [
