   "id": "Q_GEN_PSYCH_SCHIZO_013",
   "subject": "Psychiatry",
   "topic": "Schizophrenia & psychosis",
   "part": "B",
   "difficulty": "E",
   "stem": "A previously well 28-year-old develops delusions and hallucinations two days after a major life stressor; the symptoms fully resolve within 3 weeks and she returns completely to her premorbid level of functioning. The most appropriate diagnosis is:",
   "options": [
    "Schizophreniform disorder",
    "Brief psychotic disorder",
    "Schizophrenia",
    "Delusional disorder"
   ],
   "correct": 1,
   "concept": "Brief psychotic disorder is defined by one or more psychotic symptoms lasting at least 1 day but less than 1 month, with an eventual full return to the premorbid level of functioning; it is frequently precipitated by a marked stressor (and a postpartum-onset specifier exists). Schizophreniform disorder (A) lasts 1-6 months, schizophrenia (C) requires 6 months of continuous signs, and delusional disorder (D) requires non-bizarre delusions for at least 1 month without the acute, self-limiting, stress-linked course seen here.",
   "reference": "Ahuja A Short Textbook of Psychiatry 8e, Ch. A Short Textbook of Psychiatry, acute and transient psychotic disorders",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
