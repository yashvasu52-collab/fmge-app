  },
  {
   "id": "Q_PED_GDM_002",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Growth & development milestones",
   "difficulty": "H",
   "stem": "A term infant's weight has fallen from the 50th to below the 3rd centile over 4 months while length and head circumference remain on the 50th. This pattern indicates:",
   "options": [
    "Familial short stature",
    "Wasting from inadequate calorie intake or increased losses, the earliest anthropometric change in undernutrition",
    "Congenital hypothyroidism",
    "Constitutional growth delay"
   ],
   "correct": 1,
   "concept": "Weight falls first, then length (stunting) and only late does head circumference fall, so the sequence of centile crossing distinguishes acute undernutrition from an endocrine or genetic cause.",
   "reference": "OP Ghai Essential Pediatrics 9e, Ch. Growth and Development",
   "verified_on": "2026-09-01"
  },
