   "stem": "Post-dural puncture headache is characteristically:",
   "options": [
    "Postural, worse on sitting and relieved by lying flat",
    "Associated with fever",
    "Worse lying flat",
    "Non-postural"
   ],
   "correct": 0,
   "concept": "Cerebrospinal fluid leak causes traction on meninges giving a postural fronto-occipital headache, commoner with large-bore cutting needles and in young women. Treatment is bed rest, fluids, caffeine and an epidural blood patch if severe.",
   "reference": "Morgan & Mikhail's Clinical Anesthesiology 6e, Ch. Spinal Anesthesia",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_AN_RA_004",
