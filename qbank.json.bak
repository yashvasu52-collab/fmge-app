  },
  {
   "id": "Q_PS_CAU_002",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Association & causation, bias, confounding, measures of risk",
   "difficulty": "M",
   "stem": "Attributable risk represents:",
   "options": [
    "The ratio of incidences",
    "The incidence in the exposed minus incidence in the unexposed, indicating public health impact",
    "The odds ratio",
    "Prevalence"
   ],
   "correct": 1,
   "concept": "Relative risk indicates strength of association and aetiological significance, while attributable risk indicates how much disease could be prevented by removing the exposure - the public health measure.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Epidemiology",
   "tags": [
