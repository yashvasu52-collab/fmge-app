   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Environmental health: air, noise, housing, climate",
   "difficulty": "M",
   "stem": "The recommended residual free chlorine in drinking water after contact time is:",
   "options": [
    "0.5 mg per litre after one hour contact",
    "5 mg per litre",
    "0.05 mg per litre",
    "No residual needed"
   ],
   "correct": 0,
   "concept": "The orthotolidine test measures residual chlorine. Break-point chlorination ensures the demand is satisfied first, and the residual guards against recontamination in the distribution system.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Water",
   "tags": [
