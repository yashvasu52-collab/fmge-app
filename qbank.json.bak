   "difficulty": "M",
   "stem": "Randomisation in a clinical trial is performed to:",
   "options": [
    "Increase sample size",
    "Ensure blinding",
    "Improve compliance",
    "Eliminate selection bias and balance known and unknown confounders between groups"
   ],
   "correct": 3,
