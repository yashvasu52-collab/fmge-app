   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood: haemopoiesis, haemostasis, blood groups",
   "difficulty": "M",
   "stem": "The intrinsic pathway of coagulation is assessed by:",
   "options": [
    "Thrombin time",
    "Bleeding time",
    "Prothrombin time",
    "Activated partial thromboplastin time"
   ],
   "correct": 3,
   "concept": "APTT assesses the intrinsic and common pathways and monitors heparin; PT with INR assesses the extrinsic pathway and monitors warfarin. Factor VII of the extrinsic pathway has the shortest half-life.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Blood",
