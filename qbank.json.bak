   "part": "A",
   "subject": "Pathology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Haemodynamics: oedema, thrombosis, embolism, infarction, shock",
   "difficulty": "H",
   "stem": "Caisson disease (decompression sickness) results from:",
   "options": [
    "Fat globules in the circulation",
    "Nitrogen gas bubbles coming out of solution on rapid decompression",
    "Amniotic fluid embolism",
    "Air entering a vein"
   ],
   "correct": 1,
   "concept": "Rapid ascent lets dissolved nitrogen form bubbles in blood and tissues, causing joint pain (the bends), respiratory distress (the chokes) and, chronically, ischaemic necrosis of femoral and humeral heads. Recompression is the treatment.",
   "reference": "Robbins & Cotran Pathologic Basis of Disease 10e, Ch. Haemodynamic Disorders",
   "tags": [
