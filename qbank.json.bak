   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Third-stage complications, retained placenta & uterine inversion",
   "difficulty": "E",
   "stem": "Active management of the third stage of labour comprises:",
   "options": [
    "Immediate manual removal",
    "Fundal pressure alone",
    "Waiting 60 minutes",
    "A uterotonic, controlled cord traction and uterine massage"
   ],
   "correct": 3,
   "concept": "Active management with an oxytocic within one minute of delivery, controlled cord traction with counter-traction and uterine massage reduces postpartum haemorrhage by about 60% and is standard care.",
   "reference": "WHO PPH Guidelines; Park 27e",
