   "topic": "Bleeding disorders, thrombophilia & anticoagulation",
   "difficulty": "E",
   "stem": "Menorrhagia since menarche with easy bruising, a normal platelet count and a mildly prolonged APTT in a young woman suggests:",
   "options": [
    "Haemophilia A carrier state",
    "Von Willebrand disease",
    "Immune thrombocytopenic purpura",
    "Scurvy"
   ],
   "correct": 1,
   "concept": "Von Willebrand factor carries factor VIII and mediates platelet adhesion, so its deficiency gives mucocutaneous bleeding with a borderline APTT and a normal count.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 65 (Disorders of Coagulation and Thrombosis)",
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a concept-similarity duplicate candidate; answer, topic and reference confirmed"
  },
