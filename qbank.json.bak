   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "M",
   "stem": "Angiogenesis in tumours is driven principally by:",
   "options": [
    "Insulin",
    "Epidermal growth factor",
    "Interferon",
    "Vascular endothelial growth factor"
   ],
   "correct": 3,
   "concept": "Tumours cannot grow beyond 1 to 2 mm without a blood supply. Bevacizumab targets VEGF, and anti-VEGF agents are also used intravitreally for wet age-related macular degeneration and diabetic retinopathy.",
