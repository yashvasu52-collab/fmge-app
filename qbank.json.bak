  {
   "id": "Q_OR_UL_006",
   "part": "B",
   "subject": "Orthopedics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Specific fractures (Colles, NOF, supracondylar) & healing",
   "difficulty": "M",
   "stem": "Supracondylar fracture of the humerus in a child most commonly injures:",
   "options": [
    "The musculocutaneous nerve",
    "The axillary nerve",
    "The ulnar nerve",
    "The anterior interosseous branch of the median nerve"
   ],
   "correct": 3,
   "concept": "The extension-type fracture displaces posteriorly, stretching the median nerve and brachial artery. Loss of the OK sign indicates anterior interosseous palsy, and vascular compromise with Volkmann contracture is the feared complication.",
   "reference": "Maheshwari Essential Orthopaedics 6e, Ch. Fractures in Children",
