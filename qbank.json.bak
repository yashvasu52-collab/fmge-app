   "verified_by": "model-audit",
   "topic": "Health planning, committees & health policy",
   "difficulty": "M",
   "stem": "The National Health Policy 2017 set a target for public health expenditure of:",
   "options": [
    "2.5 percent of GDP by 2025",
    "5 percent of GDP",
    "1 percent of GDP",
    "10 percent of GDP"
   ],
   "correct": 0,
   "concept": "It also aims to raise life expectancy to 70, reduce under-five mortality to 23 by 2025 and reduce out-of-pocket expenditure, with an emphasis on comprehensive primary health care.",
