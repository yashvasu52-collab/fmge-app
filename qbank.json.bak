  {
   "id": "Q_DE_INF_008",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial, fungal & viral skin infections; scabies, pediculosis",
   "difficulty": "H",
   "stem": "Herpes zoster involving the tip of the nose (Hutchinson sign) warns of:",
   "options": [
    "Meningitis",
    "Ocular involvement via the nasociliary nerve",
    "Deafness",
    "Facial palsy"
   ],
   "correct": 1,
   "concept": "The nasociliary branch supplies both the nasal tip and the globe, so vesicles there predict keratitis and uveitis, requiring urgent ophthalmological assessment and systemic acyclovir.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Viral Infections",
   "tags": [
