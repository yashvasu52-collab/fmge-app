  {
   "id": "Q_DE_INF_009",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial, fungal & viral skin infections; scabies, pediculosis",
   "difficulty": "H",
   "stem": "Tinea capitis requires systemic rather than topical therapy because:",
   "options": [
    "The fungus invades the hair shaft, which topical agents cannot penetrate",
    "It is not fungal",
    "It resolves spontaneously",
    "Topicals are toxic"
   ],
   "correct": 0,
   "concept": "Griseofulvin or terbinafine is required for 6 to 8 weeks. Untreated inflammatory kerion causes scarring alopecia, and household contacts should be screened as asymptomatic carriage is common.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Fungal Infections",
   "tags": [
