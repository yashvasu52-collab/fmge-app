  },
  {
   "id": "Q_MIC_RIC_004",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "E",
   "stem": "The WHO SAFE strategy for trachoma elimination comprises:",
   "options": [
    "Surgery, Antibiotics, Facial cleanliness and Environmental improvement",
    "Surgery, Analgesia, Fluids, Education",
    "Sanitation, Awareness, Food, Exercise",
    "Screening, Antibiotics, Follow-up, Education"
   ],
   "correct": 0,
   "concept": "Lid surgery for trichiasis, mass azithromycin, facial cleanliness to interrupt fly-borne transmission and environmental improvement including latrines and water form the elimination strategy.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Trachoma",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_RIC_005",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "M",
   "stem": "The commonest cause of non-gonococcal urethritis is:",
   "options": [
    "Candida",
    "Neisseria gonorrhoeae",
    "Chlamydia trachomatis serotypes D to K",
    "Treponema pallidum"
   ],
   "correct": 2,
   "concept": "Chlamydial urethritis is often asymptomatic, causing pelvic inflammatory disease, tubal infertility and ectopic pregnancy in women and reactive arthritis in HLA-B27 individuals. Doxycycline or azithromycin is used.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Chlamydiae",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
