  {
   "id": "Q_PSM_CON_007",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Concepts of health & disease, natural history, levels of prevention",
   "difficulty": "E",
   "stem": "Health promotion differs from specific protection in that it:",
   "options": [
    "Is applied after disease onset",
    "Is non-specific and aims to improve overall wellbeing through education, nutrition and lifestyle",
    "Targets one disease",
    "Requires vaccines"
   ],
   "correct": 1,
   "concept": "Health promotion includes health education, environmental modification, nutritional intervention and lifestyle change and benefits many conditions at once, whereas specific protection such as immunisation or fluoridation targets a defined disease.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Concept of Prevention",
