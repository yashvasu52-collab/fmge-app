  {
   "id": "Q_MIC_ARB_001",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Arboviruses: dengue, chikungunya, JE, Zika",
   "difficulty": "E",
   "stem": "Dengue virus has how many distinct serotypes?",
   "options": [
    "Two",
    "Four",
    "Ten",
    "One"
   ],
   "correct": 1,
   "concept": "DENV-1 to DENV-4 give lifelong homotypic immunity but only transient cross-protection, so a person can have four infections. Secondary infection with a different serotype carries the highest risk of severe dengue.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Arboviruses",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_ARB_002",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Arboviruses: dengue, chikungunya, JE, Zika",
   "difficulty": "M",
   "stem": "Antibody-dependent enhancement explains why:",
   "options": [
    "Primary infection is more severe",
    "All serotypes are identical",
    "Vaccination is unnecessary",
    "Secondary infection with a different dengue serotype is more severe than primary infection"
   ],
   "correct": 3,
   "concept": "Non-neutralising cross-reactive antibodies bind the new serotype and facilitate Fc receptor-mediated uptake into monocytes, amplifying viral load and cytokine release with plasma leakage - the basis of dengue vaccine safety concerns.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Arboviruses",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01",
