   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Innate & adaptive immunity, antigen-antibody reactions, vaccines",
   "difficulty": "M",
   "stem": "Herd immunity protects unvaccinated individuals by:",
   "options": [
    "Eliminating the pathogen from the environment",
    "Reducing the number of susceptible hosts so transmission chains break",
    "Improving nutrition",
    "Direct antibody transfer"
   ],
   "correct": 1,
   "concept": "Herd immunity works only for person-to-person transmitted infections; it does not apply to tetanus, which is acquired from the environment, so every individual must be immunised.",
