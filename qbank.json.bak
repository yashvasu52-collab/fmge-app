  {
   "id": "Q_MIC_SPC_005",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Specimen collection, serology & molecular diagnostics",
   "difficulty": "M",
   "stem": "Sputum is considered an acceptable specimen for culture when microscopy shows:",
   "options": [
    "More than 25 neutrophils and fewer than 10 squamous epithelial cells per low-power field",
    "Many epithelial cells",
    "No cells",
    "Only bacteria"
   ],
   "correct": 0,
   "concept": "Abundant squamous cells indicate salivary contamination, making culture uninterpretable. Screening by these Bartlett or Murray-Washington criteria avoids reporting misleading oropharyngeal flora.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Laboratory Diagnosis",
   "tags": [
