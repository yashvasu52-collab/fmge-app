  {
   "id": "Q_DE_PIG_002",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Pigmentary disorders (vitiligo, melasma) & genodermatoses",
   "difficulty": "M",
   "stem": "The most important differential of a hypopigmented patch in India that must be excluded is:",
   "options": [
    "Vitiligo",
    "Melasma",
    "Leprosy, by testing sensation and examining nerves",
    "Freckles"
   ],
   "correct": 2,
   "concept": "An anaesthetic hypopigmented patch with thickened peripheral nerves indicates tuberculoid leprosy. Pityriasis alba and post-inflammatory hypopigmentation are other differentials, but only leprosy has sensory loss.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Leprosy",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_DE_PIG_003",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Pigmentary disorders (vitiligo, melasma) & genodermatoses",
   "difficulty": "M",
   "stem": "Melasma is characteristically:",
   "options": [
    "Symmetrical brown facial pigmentation worsened by sun and hormones",
    "Depigmented",
    "Unilateral",
    "Associated with anaesthesia"
   ],
   "correct": 0,
   "concept": "Melasma affects the malar, centrofacial and mandibular areas of women, aggravated by pregnancy, oral contraceptives and ultraviolet light. Strict photoprotection is essential; hydroquinone and triple combination creams are used.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Pigmentary Disorders",
   "tags": [
    "#high-yield"
