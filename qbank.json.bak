  {
   "id": "Q_BC_CAN_005",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Cancer biology, oncogenes & tumour biochemistry",
   "difficulty": "M",
   "stem": "The BCL2 gene contributes to malignancy by:",
   "options": [
    "Blocking the cell cycle",
    "Promoting apoptosis",
    "Repairing DNA",
    "Inhibiting apoptosis, allowing survival of cells that should die"
   ],
   "correct": 3,
   "concept": "The t(14;18) translocation in follicular lymphoma places BCL2 under immunoglobulin heavy chain promoter control, causing overexpression - a tumour arising from failure of cell death rather than excess proliferation.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Cancer: An Overview",
   "tags": [
