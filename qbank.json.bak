   "id": "Q_GEN_PSM_COMMDIS_006",
   "subject": "PSM (Community Medicine)",
   "topic": "Epidemiology & control: TB, malaria, HIV",
   "part": "B",
   "difficulty": "M",
   "stem": "The time interval between the onset of symptoms in a primary case and the onset of symptoms in a secondary case infected by that primary case is termed the:",
   "options": [
    "Incubation period",
    "Serial interval",
    "Latent period",
    "Generation time"
   ],
   "correct": 1,
   "concept": "The SERIAL INTERVAL is the time between symptom onset in a primary case and symptom onset in the secondary case(s) it infects; because it is directly observable, it is widely used to estimate transmission dynamics and to time quarantine. Contrast: the incubation period is infection-to-symptom-onset within one person; the latent (pre-infectious) period relates to when a person becomes infectious after infection; and the generation time is the interval from infection of the primary case to infection of the secondary case. These intervals are frequently confused in examinations.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Dynamics of Disease Transmission",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
   "verified_on": "2026-09-01"
  },
