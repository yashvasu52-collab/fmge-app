   "id": "Q_PYQ_FMGE_2025JULP1_018",
   "subject": "Microbiology",
   "topic": "Malaria & other protozoa",
   "part": "A",
   "difficulty": "M",
   "stem": "An HIV-positive patient has chronic diarrhoea for 4 weeks. Stool microscopy shows oval/elliptical cysts measuring about 16 x 20 um. What is the diagnosis?",
   "options": [
    "Cryptosporidium",
    "Cryptococcus",
    "Cyclospora",
    "Cystoisospora"
   ],
   "correct": 3,
   "concept": "Large oval/ellipsoidal acid-fast oocysts (roughly 16-20 um and larger) causing chronic diarrhoea in an HIV patient indicate Cystoisospora belli (formerly Isospora), treated with cotrimoxazole. Cryptosporidium oocysts are small (4-6 um) and round, Cyclospora are about 8-10 um, and Cryptococcus is a fungus causing meningitis, not diarrhoea.",
   "reference": "FMGE July 2025 Part 1 (real exam recall); Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Protozoa",
