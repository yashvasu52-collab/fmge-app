  {
   "id": "Q_PED_EMG_001",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Paediatric emergencies, poisoning & IMNCI",
   "difficulty": "E",
   "stem": "In paediatric basic life support by a single rescuer, the compression to ventilation ratio is:",
   "options": [
    "30 to 2 for a lay rescuer and 15 to 2 for two healthcare providers",
    "50 to 2",
    "5 to 1",
    "3 to 1 in all children"
   ],
   "correct": 0,
   "concept": "A lone rescuer uses 30 to 2, while two healthcare providers use 15 to 2 in infants and children, reflecting the predominantly respiratory aetiology of paediatric arrest. Newborn resuscitation uses 3 to 1.",
   "reference": "American Heart Association Guidelines for Cardiopulmonary Resuscitation and Emergency Cardiovascular Care 2020, Pediatric Advanced Life Support; OP Ghai Essential Pediatrics 9e, Ch. Pediatric Emergencies",
   "tags": [
    "#high-yield"
