  {
   "id": "Q_OR_LL_009",
   "part": "B",
   "subject": "Orthopedics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Lower limb & pelvic injuries; hip dislocation",
   "difficulty": "H",
   "stem": "Common peroneal nerve injury at the neck of the fibula produces:",
   "options": [
    "Claw toes only",
    "Loss of knee extension",
    "Loss of plantar flexion",
    "Foot drop with loss of sensation over the dorsum of the foot"
   ],
   "correct": 3,
   "concept": "The nerve is superficial at the fibular neck, vulnerable to fractures, tight casts and prolonged squatting. Loss of dorsiflexion and eversion gives a high-stepping gait; the sole is spared as it is supplied by the tibial nerve.",
   "reference": "Maheshwari Essential Orthopaedics 6e, Ch. Peripheral Nerve Lesions",
   "tags": [
