  {
   "id": "Q_MIC_HRP_007",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Herpesviruses, CMV & EBV",
   "difficulty": "E",
   "stem": "Owl's eye intranuclear inclusions are characteristic of:",
   "options": [
    "Rabies",
    "Cytomegalovirus",
    "Measles",
    "Herpes simplex"
   ],
   "correct": 1,
   "concept": "CMV produces markedly enlarged cells with a large basophilic intranuclear inclusion surrounded by a clear halo. It causes congenital infection with periventricular calcification and deafness, and retinitis in advanced HIV.",
