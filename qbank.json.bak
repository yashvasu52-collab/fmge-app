  },
  {
   "id": "Q_DE_INF_010",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial, fungal & viral skin infections; scabies, pediculosis",
   "difficulty": "M",
   "stem": "Pediculosis capitis is best treated with:",
   "options": [
    "Shaving the head only",
    "Oral antibiotics",
    "Topical permethrin with wet combing and treatment of close contacts",
    "Topical steroids"
   ],
   "correct": 2,
   "concept": "Permethrin 1% or malathion kills lice, with a repeat application after 7 to 10 days to kill nymphs hatching from surviving eggs. Combing removes nits, and fomites such as combs and pillows are treated.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Infestations",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_DE_ECZ_001",
   "part": "B",
   "subject": "Dermatology",
