  },
  {
   "id": "Q_MIC_NEI_004",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Neisseria, Haemophilus, Bordetella, Brucella",
   "difficulty": "E",
   "stem": "Chemoprophylaxis of close contacts of a meningococcal meningitis case is with:",
   "options": [
    "Penicillin",
    "Rifampicin, ciprofloxacin or ceftriaxone",
    "Ampicillin",
    "Cotrimoxazole"
   ],
   "correct": 1,
   "concept": "Prophylaxis eradicates nasopharyngeal carriage, which penicillin does not achieve despite treating invasive disease. It should be given within 24 hours to household and other close contacts.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Meningococcal Meningitis",
   "tags": [
    "#high-yield",
    "#DoC"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_NEI_006",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Neisseria, Haemophilus, Bordetella, Brucella",
   "difficulty": "M",
   "stem": "Hib vaccine protects against invasive disease because it is:",
   "options": [
    "A live vaccine",
    "A polysaccharide-protein conjugate immunogenic in infants",
    "A killed whole-cell vaccine",
    "A toxoid"
   ],
   "correct": 1,
   "concept": "Plain polysaccharide vaccines are poorly immunogenic under 2 years as they are T-independent antigens; conjugation to a carrier protein recruits T-cell help, giving memory and herd protection in infancy.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Haemophilus",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_NEI_008",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Neisseria, Haemophilus, Bordetella, Brucella",
   "difficulty": "H",
   "stem": "The most infectious stage of whooping cough is:",
   "options": [
    "The paroxysmal stage",
    "The catarrhal stage, before the characteristic cough appears",
    "After antibiotics",
    "The convalescent stage"
   ],
   "correct": 1,
   "concept": "Infectivity is highest before diagnosis is clinically obvious, which is why contact prophylaxis with a macrolide and high vaccine coverage matter more than treating the established paroxysmal stage.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Whooping Cough",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_NEI_010",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Neisseria, Haemophilus, Bordetella, Brucella",
   "difficulty": "M",
   "stem": "Brucellosis in humans is most often acquired from:",
   "options": [
    "Contaminated water",
    "Unpasteurised milk and milk products, or occupational animal contact",
    "Person-to-person contact",
    "Mosquito bite"
   ],
   "correct": 1,
   "concept": "Brucella melitensis from goats and sheep causes the most severe human disease. Veterinarians, abattoir workers and laboratory staff are occupationally at risk, and treatment requires prolonged combination therapy.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Brucellosis",
   "tags": [
    "#high-yield"
   ],
