   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Association & causation, bias, confounding, measures of risk",
   "difficulty": "M",
   "stem": "The Bradford Hill criterion carrying the greatest weight for causation is:",
   "options": [
    "Strength of association",
    "Analogy",
    "Plausibility",
    "Temporality - the exposure must precede the outcome"
   ],
   "correct": 3,
   "concept": "Temporality is the only absolutely necessary criterion; all others strengthen the argument but none alone proves causation. Strength, consistency, dose-response and reversibility are the next most persuasive.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Epidemiology",
   "tags": [
