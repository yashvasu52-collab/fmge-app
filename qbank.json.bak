  {
   "id": "Q_SUR_TRF_001",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "E",
   "stem": "The commonest cause of a fatal acute haemolytic transfusion reaction is:",
   "options": [
    "ABO incompatibility from clerical error in patient identification",
    "Bacterial contamination",
    "Rh incompatibility",
    "Febrile reaction"
   ],
   "correct": 0,
   "concept": "Misidentification of patient or sample leading to ABO-incompatible transfusion causes complement-mediated intravascular haemolysis with fever, loin pain, hypotension, haemoglobinuria and disseminated intravascular coagulation. The transfusion must be stopped immediately.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_002",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "M",
   "stem": "Massive blood transfusion is commonly complicated by:",
   "options": [
    "Hypothermia, hypocalcaemia from citrate, hyperkalaemia and dilutional coagulopathy",
    "Hypercalcaemia",
    "Polycythaemia",
    "Metabolic alkalosis only"
   ],
   "correct": 0,
   "concept": "Stored blood is cold, citrated and potassium-rich with no functional platelets or labile clotting factors, so massive transfusion requires warming, calcium supplementation and balanced replacement with plasma and platelets.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_003",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "M",
   "stem": "The commonest transfusion reaction overall is:",
   "options": [
    "Febrile non-haemolytic reaction from leucocyte antibodies and cytokines",
    "TRALI",
    "Acute haemolysis",
    "Anaphylaxis"
   ],
   "correct": 0,
   "concept": "Febrile non-haemolytic reactions from donor leucocytes and accumulated cytokines are the commonest, prevented by leucodepletion. Haemolysis must always be excluded before attributing fever to this benign cause.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_004",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "E",
   "stem": "Fresh frozen plasma is indicated for:",
   "options": [
    "Volume expansion",
    "Replacement of multiple coagulation factor deficiencies with active bleeding or before an urgent procedure",
    "Correction of anaemia",
    "Nutritional support"
   ],
   "correct": 1,
   "concept": "FFP contains all clotting factors and is used in coagulopathy of liver disease, disseminated intravascular coagulation, massive transfusion and urgent warfarin reversal when concentrates are unavailable. It should not be used as a volume expander.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_005",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "M",
   "stem": "Cryoprecipitate is particularly rich in:",
   "options": [
    "Immunoglobulins",
    "Fibrinogen, factor VIII, von Willebrand factor and factor XIII",
    "Albumin",
    "Platelets"
   ],
   "correct": 1,
   "concept": "Cryoprecipitate is the preferred fibrinogen source in disseminated intravascular coagulation and massive haemorrhage when fibrinogen falls below about 1.5 g/L, and also supplies factor VIII, vWF and factor XIII.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_006",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "M",
   "stem": "Transfusion-related acute lung injury (TRALI) presents as:",
   "options": [
    "Urticaria only",
    "Acute non-cardiogenic pulmonary oedema within six hours of transfusion",
    "Cardiogenic pulmonary oedema",
    "Delayed jaundice"
   ],
   "correct": 1,
   "concept": "Donor antibodies against recipient leucocytes cause acute hypoxaemia with bilateral infiltrates and normal filling pressures within 6 hours, distinguishing it from circulatory overload. Treatment is supportive and it is a leading cause of transfusion mortality.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_007",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "E",
   "stem": "Anaphylactic transfusion reactions occur classically in recipients with:",
   "options": [
    "IgA deficiency and anti-IgA antibodies",
    "Rh negativity",
    "Thalassaemia trait",
    "Sickle cell trait"
   ],
   "correct": 0,
   "concept": "IgA-deficient recipients with anti-IgA antibodies react anaphylactically to IgA in donor plasma, and require washed red cells or IgA-deficient products for future transfusions.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_008",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "H",
   "stem": "The universal donor for packed red cells and universal donor for plasma are respectively:",
   "options": [
    "O negative and AB",
    "A and B",
    "O positive and A",
    "AB and O negative"
   ],
   "correct": 0,
   "concept": "O negative red cells lack A, B and D antigens so can be given to anyone, while AB plasma contains neither anti-A nor anti-B antibodies making it the universal plasma donor - the relationship is inverted between components.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_009",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "H",
   "stem": "Tranexamic acid reduces surgical bleeding by:",
   "options": [
    "Inhibiting plasminogen activation and thereby fibrinolysis",
    "Supplying fibrinogen",
    "Activating platelets",
    "Antagonising heparin"
   ],
   "correct": 0,
   "concept": "Tranexamic acid is a lysine analogue that blocks plasminogen binding to fibrin, stabilising clot. It reduces mortality in trauma haemorrhage when given within three hours (CRASH-2) and in postpartum haemorrhage.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs Affecting Coagulation",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_TRF_010",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Blood transfusion & coagulation in surgery",
   "difficulty": "M",
   "stem": "Autologous blood transfusion has the principal advantage of:",
   "options": [
    "Providing platelets",
    "Being available in emergencies",
    "Avoiding alloimmunisation and transfusion-transmitted infection",
    "Correcting coagulopathy"
   ],
   "correct": 2,
   "concept": "Predeposit autologous donation, acute normovolaemic haemodilution and intraoperative cell salvage avoid immunological reactions and infection transmission, though cell salvage is avoided where the field is contaminated by infection or malignancy.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Blood Transfusion",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_LIV_001",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Liver, spleen & portal hypertension surgery",
   "difficulty": "E",
   "stem": "The commonest cause of portal hypertension in India is:",
   "options": [
    "Portal vein thrombosis",
    "Schistosomiasis",
    "Budd-Chiari syndrome",
    "Cirrhosis of the liver"
   ],
   "correct": 3,
   "concept": "Cirrhosis is the commonest cause overall, giving intrahepatic sinusoidal obstruction. Extrahepatic portal vein obstruction is an important cause of variceal bleeding in Indian children with preserved liver function.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Liver",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_LIV_002",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Liver, spleen & portal hypertension surgery",
   "difficulty": "M",
   "stem": "The first-line treatment for acute variceal bleeding is:",
   "options": [
    "Beta blocker alone",
    "Resuscitation with endoscopic variceal band ligation and a vasoactive drug such as terlipressin or octreotide",
    "Immediate portosystemic shunt surgery",
    "Balloon tamponade as definitive therapy"
   ],
   "correct": 1,
   "concept": "Resuscitation, vasoactive drugs, antibiotic prophylaxis and urgent endoscopic band ligation control most bleeds. Balloon tamponade is a temporary bridge, and TIPS is used for failure of endoscopic control.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Liver",
   "tags": [
    "#high-yield",
    "#DoC"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_LIV_003",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Liver, spleen & portal hypertension surgery",
   "difficulty": "M",
   "stem": "Primary prophylaxis against variceal bleeding in a cirrhotic with large varices uses:",
   "options": [
    "Aspirin",
    "Warfarin",
    "Proton pump inhibitors",
    "Non-selective beta blockers such as propranolol or carvedilol, or band ligation"
   ],
   "correct": 3,
   "concept": "Non-selective beta blockade reduces portal pressure by splanchnic vasoconstriction and reduced cardiac output; band ligation is an alternative for those intolerant. Selective beta-1 blockers do not work because the splanchnic beta-2 effect is required.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Liver; KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Antihypertensives",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "the reference gave both books in short form with no chapter for either"
  },
