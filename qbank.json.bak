   "verified_on": "2026-09-01",
   "verify_note": "the reference read \"AHA PALS Guidelines\" with no year or supporting textbook"
  },
  {
   "id": "Q_PED_EMG_002",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Paediatric emergencies, poisoning & IMNCI",
   "difficulty": "M",
   "stem": "The first-line drug for a child in status epilepticus with intravenous access is:",
   "options": [
    "Intramuscular phenobarbitone",
    "Intravenous mannitol",
    "Intravenous lorazepam or midazolam",
    "Oral phenytoin"
   ],
   "correct": 2,
   "concept": "A benzodiazepine - lorazepam intravenously or midazolam intranasally or buccally without access - is first line, repeated once, followed by a second-line agent such as fosphenytoin, levetiracetam or valproate if seizures persist.",
   "reference": "OP Ghai Essential Pediatrics 9e, Ch. Paediatric Emergencies; KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Antiepileptic Drugs",
   "tags": [
