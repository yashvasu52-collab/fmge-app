  {
   "id": "Q_PY_LNG_005",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Lung volumes, compliance, V/Q & mechanics of breathing",
   "difficulty": "M",
   "stem": "A ventilation-perfusion ratio of zero represents:",
   "options": [
    "Dead space",
    "Normal lung",
    "A true shunt, where perfused alveoli receive no ventilation",
    "Emphysema"
   ],
   "correct": 2,
   "concept": "Shunt causes hypoxaemia that does not correct with 100% oxygen, distinguishing it from V/Q mismatch. Consolidation, atelectasis and pulmonary oedema are common causes.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Respiration",
   "tags": [
