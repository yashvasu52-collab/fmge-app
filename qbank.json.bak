  },
  {
   "id": "Q_OBG_PTL_009",
   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Preterm labour, PROM & post-term pregnancy",
   "difficulty": "H",
   "stem": "Fetal fibronectin testing in threatened preterm labour is most useful because:",
   "options": [
    "A negative result has a high negative predictive value, allowing safe avoidance of intervention",
    "It measures lung maturity",
    "A positive result confirms delivery within 24 hours",
    "It replaces cervical length measurement"
   ],
   "correct": 0,
   "concept": "Fetal fibronectin has high negative predictive value, so a negative test in a symptomatic woman reliably excludes imminent delivery and avoids unnecessary steroids, tocolysis and transfer; a positive test is much less specific.",
   "reference": "Williams Obstetrics 26e, Ch. Preterm Birth",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_OBG_PTL_010",
   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Preterm labour, PROM & post-term pregnancy",
   "difficulty": "M",
   "stem": "The commonest identifiable cause of spontaneous preterm labour is:",
   "options": [
    "Placenta praevia",
    "Fetal anomaly",
    "Intrauterine or genital tract infection",
    "Maternal hypertension"
   ],
   "correct": 2,
   "concept": "Subclinical intrauterine infection accounts for a large proportion of spontaneous preterm labour, especially at earlier gestations, followed by uterine overdistension, cervical insufficiency and abruption.",
   "reference": "Williams Obstetrics 26e, Ch. Preterm Birth",
