   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Health planning, committees & health policy",
   "difficulty": "H",
   "stem": "The Chadah Committee dealt with:",
   "options": [
    "Malaria maintenance phase, recommending surveillance by basic health workers",
    "Family planning",
    "Medical education",
    "Nursing"
   ],
   "correct": 0,
   "concept": "It proposed that malaria vigilance be integrated with general health services rather than run vertically - an early recognition of the value of horizontal integration.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Health Planning",
   "tags": [
    "#high-yield"
