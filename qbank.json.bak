   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Association & causation, bias, confounding, measures of risk",
   "difficulty": "M",
   "stem": "A study finds coffee drinking associated with lung cancer, but coffee drinkers smoke more. Smoking here is acting as:",
   "options": [
    "A source of random error",
    "An effect modifier",
    "A mediator on the causal pathway",
    "A confounder, being associated with the exposure and an independent risk factor for the outcome"
   ],
   "correct": 3,
   "concept": "Confounding is controlled at design by randomisation, matching or restriction, and at analysis by stratification or multivariable adjustment; a variable on the causal pathway would be a mediator and should not be adjusted for.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Epidemiology",
   "verified_on": "2026-09-01"
  },
