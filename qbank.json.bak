  {
   "id": "Q_DE_ECZ_005",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Eczema, atopic & contact dermatitis, urticaria",
   "difficulty": "M",
   "stem": "Eczema herpeticum is:",
   "options": [
    "A drug reaction",
    "Disseminated herpes simplex infection of eczematous skin, a dermatological emergency",
    "A fungal infection",
    "A bacterial infection"
   ],
   "correct": 1,
   "concept": "Monomorphic punched-out erosions with fever in a child with atopic eczema require urgent systemic acyclovir, as it can be fatal. Barrier disruption in eczema permits widespread viral spread.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Eczema",
   "tags": [
