  {
   "id": "Q_PY_GIT_010",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "M",
   "stem": "Saliva has which principal digestive function?",
   "options": [
    "Fat digestion",
    "Protein digestion",
    "Starch digestion by salivary amylase, with lubrication and antibacterial action",
    "Vitamin absorption"
   ],
   "correct": 2,
   "concept": "Saliva is hypotonic with high potassium and bicarbonate. It also contains lysozyme, lactoferrin and IgA, which is why xerostomia predisposes to dental caries and oral candidiasis.",
