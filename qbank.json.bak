  {
   "id": "Q_MIC_RIC_007",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "E",
   "stem": "Mycoplasma pneumoniae infection may be associated with:",
   "options": [
    "Neutropenia",
    "Endocarditis",
    "Renal failure",
    "Cold agglutinin haemolysis and erythema multiforme"
   ],
   "correct": 3,
   "concept": "Anti-I cold agglutinins cause haemolysis, and extrapulmonary manifestations include erythema multiforme, bullous myringitis, Guillain-Barre syndrome and arthritis. Radiographic changes exceed the clinical findings.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Mycoplasma",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
