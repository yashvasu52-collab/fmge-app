   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PSM_CON_005",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Concepts of health & disease, natural history, levels of prevention",
   "difficulty": "M",
   "stem": "The epidemiological triad consists of:",
   "options": [
    "Incidence, prevalence and mortality",
    "Time, place and person",
    "Agent, host and environment",
    "Sensitivity, specificity and predictive value"
   ],
   "correct": 2,
   "concept": "Disease results from interaction between agent, host and environment; breaking any link controls disease. The multifactorial causation model and the web of causation extend this for non-communicable disease.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Concepts in Epidemiology",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
