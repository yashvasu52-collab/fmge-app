   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PY_GIT_006",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "M",
   "stem": "The migrating motor complex functions to:",
   "options": [
    "Mix food during meals",
    "Slow transit",
    "Increase absorption",
    "Sweep undigested residue and bacteria along the gut during fasting"
   ],
   "correct": 3,
   "concept": "Governed by motilin and abolished by feeding, it is the intestinal housekeeper. Its impairment contributes to small intestinal bacterial overgrowth in diabetic autonomic neuropathy and scleroderma.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Gastrointestinal Physiology",
   "tags": [
