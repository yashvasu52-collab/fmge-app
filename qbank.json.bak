  {
   "id": "Q_MIC_HRP_002",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Herpesviruses, CMV & EBV",
   "difficulty": "M",
   "stem": "Multinucleated giant cells with intranuclear inclusions on a Tzanck smear indicate:",
   "options": [
    "Human papillomavirus",
    "Herpes simplex or varicella zoster infection",
    "Cytomegalovirus",
    "Molluscum contagiosum"
   ],
   "correct": 1,
   "concept": "The Tzanck smear from a fresh vesicle base shows ballooning degeneration with multinucleate giant cells and Cowdry type A intranuclear inclusions, present in both HSV and VZV, so it cannot distinguish between them.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Herpesviruses",
