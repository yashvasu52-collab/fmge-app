  },
  {
   "id": "Q_PS_MSE_001",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "E",
   "stem": "The mental status examination assesses all EXCEPT:",
   "options": [
    "Thought and perception",
    "Mood and affect",
    "Past medical history",
    "Appearance and behaviour"
   ],
   "correct": 2,
   "concept": "The MSE is a cross-sectional assessment of the present state - appearance, behaviour, speech, mood, affect, thought, perception, cognition, insight and judgement. Past history belongs to the psychiatric history.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Psychiatric Interview",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_002",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "M",
   "stem": "The difference between mood and affect is that mood is:",
   "options": [
    "The patient's sustained subjective emotional state, while affect is the observed emotional expression",
    "Observed and affect subjective",
    "Always abnormal",
    "Measured objectively"
   ],
   "correct": 0,
   "concept": "Mood is reported by the patient and pervasive; affect is the examiner's observation of its outward expression, described by range, reactivity and congruence. Incongruent affect is characteristic of schizophrenia.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Psychiatric Interview",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_003",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "M",
   "stem": "A delusion is best defined as:",
   "options": [
    "An overvalued idea",
    "A fixed false belief not amenable to reason and out of keeping with cultural background",
    "An obsessive thought",
    "A false sensory perception"
   ],
   "correct": 1,
   "concept": "Delusions are disorders of thought content and must be judged against cultural context. A hallucination is a perception without a stimulus, and an obsession is recognised by the patient as their own and resisted.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Signs and Symptoms",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_004",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "E",
   "stem": "Insight in psychiatry refers to:",
   "options": [
    "Memory",
    "Orientation",
    "Intelligence",
    "The patient's awareness that they are ill and need treatment"
   ],
   "correct": 3,
   "concept": "Insight is graded from complete denial of illness to full awareness with understanding of its nature. It is typically absent in psychosis and mania but preserved in neurotic disorders, and predicts treatment adherence.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Psychiatric Interview",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_005",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "M",
   "stem": "Formal thought disorder with loosening of associations is characteristic of:",
   "options": [
    "Schizophrenia",
    "Anxiety disorder",
    "Phobia",
    "Depression"
   ],
   "correct": 0,
   "concept": "Derailment, tangentiality, neologisms and word salad reflect disorganised thought form, a core feature of schizophrenia. Flight of ideas with retained connections is typical of mania.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Schizophrenia",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a cross-topic duplicate candidate; answer, topic and reference confirmed"
  },
  {
   "id": "Q_PS_MSE_006",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "M",
   "stem": "The classification system used officially in India for psychiatric diagnosis is:",
   "options": [
    "Neither",
    "DSM, published by the American Psychiatric Association",
    "Both are legally mandated",
    "ICD, published by WHO"
   ],
   "correct": 3,
   "concept": "India follows the WHO International Classification of Diseases, while DSM is widely used in research and teaching. Both are descriptive, operational and largely atheoretical regarding causation.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Classification",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_007",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "E",
   "stem": "Confabulation refers to:",
   "options": [
    "A hallucination",
    "Deliberate lying",
    "Filling gaps in memory with fabricated material without intent to deceive",
    "A delusion"
   ],
   "correct": 2,
   "concept": "Confabulation is characteristic of Korsakoff psychosis from thiamine deficiency, where the patient unknowingly invents plausible accounts to bridge amnesic gaps. It is distinguished from malingering by the absence of intent.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_008",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "H",
   "stem": "Thought insertion, withdrawal and broadcasting are examples of:",
   "options": [
    "Obsessional thoughts",
    "Dissociation",
    "Depressive cognitions",
    "Schneiderian first-rank symptoms suggesting schizophrenia"
   ],
   "correct": 3,
   "concept": "First-rank symptoms include audible thoughts, third-person hallucinations, running commentary, passivity phenomena and delusional perception. They are suggestive but not pathognomonic, occurring also in mania and organic states.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Schizophrenia",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_009",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "H",
   "stem": "An illusion differs from a hallucination in that an illusion is:",
   "options": [
    "Always pathological",
    "A perception without any stimulus",
    "A misinterpretation of a real external stimulus",
    "Only visual"
   ],
   "correct": 2,
   "concept": "Illusions occur in normal people, especially with poor lighting, fatigue or anxiety, and are prominent in delirium. Hallucinations occur without any external stimulus and carry greater diagnostic weight.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Signs and Symptoms",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_MSE_010",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Psychiatric history, mental status examination & classification (ICD/DSM)",
   "difficulty": "M",
   "stem": "The Mini-Mental State Examination principally screens for:",
   "options": [
    "Depression",
    "Cognitive impairment",
    "Psychosis",
    "Anxiety"
   ],
   "correct": 1,
   "concept": "The MMSE scores orientation, registration, attention, recall, language and construction out of 30, with scores below 24 suggesting impairment. It is influenced by education and is a screen, not a diagnosis.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_001",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "E",
   "stem": "The cardinal feature distinguishing delirium from dementia is:",
   "options": [
    "Impaired attention with acute onset and fluctuating course",
    "Personality change",
    "Disorientation",
    "Memory loss"
   ],
   "correct": 0,
   "concept": "Delirium is an acute confusional state with clouding of consciousness, impaired attention, fluctuation and often visual hallucinations, and is reversible once the precipitant is treated. Dementia is chronic with attention preserved until late.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield",
    "#PYQ"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_002",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "The commonest precipitants of delirium in a hospitalised elderly patient include all EXCEPT:",
   "options": [
    "Drugs and drug withdrawal",
    "Infection",
    "Electrolyte disturbance",
    "Schizophrenia"
   ],
   "correct": 3,
   "concept": "Delirium is always secondary to a medical cause - infection, drugs especially anticholinergics and benzodiazepines, hypoxia, metabolic derangement, retention or constipation. Schizophrenia is a primary psychiatric disorder, not a cause of delirium.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a cross-topic duplicate candidate; answer, topic and reference confirmed"
  },
  {
   "id": "Q_PS_DEL_003",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "The drug of choice for agitation in delirium is:",
   "options": [
    "An anticholinergic",
    "Chlorpromazine",
    "A benzodiazepine in all cases",
    "Low-dose haloperidol, after treating the underlying cause"
   ],
   "correct": 3,
   "concept": "Antipsychotics are preferred except in alcohol or benzodiazepine withdrawal delirium, where benzodiazepines are indicated. Non-pharmacological measures - reorientation, lighting, familiar attendants - come first.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Antipsychotic Drugs",
   "tags": [
    "#high-yield",
    "#DoC"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_004",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "E",
   "stem": "Delirium tremens characteristically occurs after alcohol cessation at:",
   "options": [
    "48 to 72 hours",
    "2 hours",
    "2 weeks",
    "1 month"
   ],
   "correct": 0,
   "concept": "Simple withdrawal begins at 6 to 24 hours, withdrawal seizures at 12 to 48 hours, and delirium tremens at 48 to 72 hours with tremor, autonomic overactivity, and vivid visual and tactile hallucinations. It carries significant mortality and is treated with benzodiazepines and thiamine.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Substance Use Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_005",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "Wernicke encephalopathy must be treated with parenteral thiamine before glucose because:",
   "options": [
    "Glucose is toxic",
    "Thiamine blocks glucose absorption",
    "Glucose causes seizures",
    "A glucose load consumes remaining thiamine and can precipitate or worsen the encephalopathy"
   ],
   "correct": 3,
   "concept": "Thiamine is a cofactor for pyruvate dehydrogenase and transketolase; giving carbohydrate to a depleted patient exhausts residual stores. Untreated Wernicke progresses to irreversible Korsakoff psychosis.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. Vitamin and Trace Mineral Deficiency; Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "the reference named two books with no chapter for either; chapters added"
  },
  {
   "id": "Q_PS_DEL_006",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "The commonest reversible cause of dementia worth actively excluding is:",
   "options": [
    "Hypothyroidism and vitamin B12 deficiency",
    "Vascular dementia",
    "Lewy body dementia",
    "Alzheimer disease"
   ],
   "correct": 0,
   "concept": "Screening for hypothyroidism, B12 deficiency, neurosyphilis, HIV, normal pressure hydrocephalus and chronic subdural haematoma is essential because these are treatable, unlike the neurodegenerative dementias.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_007",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "E",
   "stem": "Frontotemporal dementia is distinguished from Alzheimer disease by:",
   "options": [
    "Visual hallucinations",
    "Stepwise decline",
    "Early memory loss",
    "Early personality change and disinhibition with relatively preserved memory"
   ],
   "correct": 3,
   "concept": "Pick disease and related tauopathies affect frontal and temporal lobes first, producing behavioural disinhibition, apathy and language impairment before amnesia, typically at a younger age than Alzheimer disease.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_008",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "H",
   "stem": "Cholinesterase inhibitors such as donepezil are used in Alzheimer disease because:",
   "options": [
    "GABA is deficient",
    "Cortical cholinergic neurons from the nucleus basalis of Meynert degenerate early",
    "Dopamine is deficient",
    "Serotonin is deficient"
   ],
   "correct": 1,
   "concept": "Loss of cholinergic projections underlies much of the cognitive deficit, so inhibiting acetylcholinesterase gives modest symptomatic benefit. Memantine, an NMDA antagonist, is added in moderate to severe disease.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Neurodegenerative Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_009",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "H",
   "stem": "Antipsychotics must be used with extreme caution in dementia with Lewy bodies because:",
   "options": [
    "They worsen memory only",
    "They cause sedation only",
    "They are ineffective",
    "Patients show severe neuroleptic sensitivity with worsening rigidity and possible death"
   ],
   "correct": 3,
   "concept": "Marked D2 sensitivity can precipitate irreversible parkinsonism and neuroleptic malignant syndrome. If antipsychotics are unavoidable, quetiapine or clozapine in very low doses is preferred.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PS_DEL_010",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Delirium, dementia & organic mental disorders",
   "difficulty": "M",
   "stem": "Sundowning refers to:",
   "options": [
    "Improvement at night",
    "Worsening of confusion and agitation in the evening in delirium and dementia",
    "Daytime sleepiness",
    "Early morning wakening"
   ],
   "correct": 1,
   "concept": "Reduced sensory cues and disrupted circadian rhythm worsen confusion after dusk. Management is environmental - adequate lighting, orientation cues, familiar people and consistent routine - rather than sedation.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Neurocognitive Disorders",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
