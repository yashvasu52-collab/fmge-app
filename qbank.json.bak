   "topic": "Bleeding disorders, thrombophilia & anticoagulation",
   "difficulty": "M",
   "stem": "A fall in platelet count between days 5 and 10 of heparin therapy with new thrombosis indicates:",
   "options": [
    "Disseminated intravascular coagulation",
    "Heparin-induced thrombocytopenia",
    "Immune thrombocytopenic purpura",
    "Dilutional thrombocytopenia"
   ],
   "correct": 1,
   "concept": "Antibodies to the heparin-platelet factor 4 complex activate platelets, so the paradox is thrombosis with a falling count; heparin must stop and a non-heparin anticoagulant such as argatroban or fondaparinux started.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 65 (Disorders of Coagulation and Thrombosis)",
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a concept-similarity duplicate candidate; answer, topic and reference confirmed"
  },
