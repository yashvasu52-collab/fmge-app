   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PH_PRK_004",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Skeletal muscle relaxants & drugs for Parkinsonism",
   "difficulty": "E",
   "stem": "Anticholinergics such as trihexyphenidyl are most useful in Parkinsonism for:",
   "options": [
    "Gait freezing",
    "Bradykinesia",
    "Postural instability",
    "Tremor, particularly in younger patients and drug-induced parkinsonism"
   ],
   "correct": 3,
   "concept": "They restore the dopamine-acetylcholine balance in the striatum and are the treatment of choice for drug-induced parkinsonism, where levodopa would be ineffective. They are avoided in the elderly because of confusion.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Parkinsonism",
   "tags": [
