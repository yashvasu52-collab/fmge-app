   "topic": "Specimen collection, serology & molecular diagnostics",
   "difficulty": "M",
   "stem": "Cartridge-based nucleic acid amplification testing (CBNAAT/GeneXpert) for tuberculosis provides:",
   "options": [
    "Detection of M. tuberculosis and rifampicin resistance within about two hours",
    "Culture confirmation",
    "Drug levels",
    "Serological diagnosis"
   ],
   "correct": 0,
