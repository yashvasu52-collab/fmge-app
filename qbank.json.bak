  {
   "id": "Q_PY_GIT_007",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "E",
   "stem": "The primary site of water absorption in the gastrointestinal tract is:",
   "options": [
    "The small intestine, with the colon absorbing the remainder",
    "The oesophagus",
    "The stomach",
    "The colon predominantly"
   ],
   "correct": 0,
   "concept": "About 8 to 9 litres enter the small bowel daily of which most is absorbed there, leaving 1 to 2 litres for the colon which absorbs all but about 100 mL - hence small bowel disease causes voluminous diarrhoea.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Gastrointestinal Physiology",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PY_GIT_008",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "H",
   "stem": "Glucose absorption from the intestinal lumen occurs by:",
   "options": [
    "Primary active transport",
    "Simple diffusion",
    "Sodium-coupled secondary active transport via SGLT1",
    "Pinocytosis"
   ],
   "correct": 2,
   "concept": "This is the physiological basis of oral rehydration solution, in which glucose drives sodium and hence water absorption even when secretory diarrhoea is active.",
