   "id": "Q_c1_001",
   "subject": "Pathology",
   "topic": "Cell injury, adaptation, necrosis vs apoptosis",
   "part": "A",
   "difficulty": "E",
   "stem": "A 58-year-old man dies 24 hours after an acute anterior myocardial infarction. Microscopy of the infarcted myocardium shows preserved 'ghost' tissue outlines with loss of nuclei and increased cytoplasmic eosinophilia. This appearance represents which type of necrosis?",
   "options": [
    "Liquefactive necrosis",
    "Coagulative necrosis",
    "Caseous necrosis",
    "Fat necrosis"
   ],
   "correct": 1,
   "concept": "Ischemic necrosis of all solid organs except the brain produces coagulative necrosis: protein denaturation preserves the cellular outline while the nucleus is lost. Brain infarcts undergo liquefactive necrosis. Caseous necrosis is typical of TB granulomas.",
   "reference": "Robbins & Cotran Pathologic Basis of Disease 10e, Ch. 2 (Cell Injury)",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
   "verified_on": "2026-09-01"
  },
