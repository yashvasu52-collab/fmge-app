  {
   "id": "Q_PSM_VBD_002",
   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vector-borne disease: dengue, chikungunya, filaria, kala-azar",
   "difficulty": "M",
   "stem": "The warning signs in dengue that predict progression to severe disease include:",
   "options": [
    "Fever alone",
    "Persistent vomiting, abdominal pain, mucosal bleeding and a rising haematocrit with falling platelets",
    "Rash alone",
    "Headache alone"
   ],
   "correct": 1,
   "concept": "Warning signs mark the critical phase around defervescence on days 3 to 7 when plasma leakage occurs. Rising haematocrit with falling platelets indicates leakage requiring careful isotonic fluid therapy, not platelet transfusion.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Dengue",
   "tags": [
