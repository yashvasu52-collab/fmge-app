   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_PY_GIT_003",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "M",
   "stem": "Secretin is released from the duodenum in response to:",
   "options": [
    "Acid, stimulating pancreatic bicarbonate secretion",
    "Fat",
    "Protein",
    "Glucose"
   ],
   "correct": 0,
   "concept": "Cholecystokinin is released by fat and protein, causing gallbladder contraction, sphincter of Oddi relaxation and pancreatic enzyme secretion - a useful pairing to remember with secretin.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Gastrointestinal Physiology",
   "tags": [
