  {
   "id": "Q_MIC_IMM_010",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Innate & adaptive immunity, antigen-antibody reactions, vaccines",
   "difficulty": "M",
   "stem": "BCG is given intradermally rather than subcutaneously because:",
   "options": [
    "It is absorbed better",
    "Deeper injection causes abscess formation and ulceration",
    "It is less painful",
    "It requires a smaller dose"
   ],
   "correct": 1,
   "concept": "Intradermal injection over the left deltoid insertion produces a wheal, then a papule, pustule and healed scar over 6 to 12 weeks. Subcutaneous injection causes cold abscess and axillary lymphadenitis.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. BCG Vaccine",
