   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Medical disorders in pregnancy: anaemia, diabetes, heart disease",
   "difficulty": "M",
   "stem": "Antiepileptic drug most associated with neural tube defects when used in pregnancy is:",
   "options": [
    "Levetiracetam",
    "Lamotrigine",
    "Sodium valproate",
    "Carbamazepine"
   ],
   "correct": 2,
   "concept": "Valproate carries the highest risk of neural tube defects and neurodevelopmental impairment and is avoided in women of childbearing age. Levetiracetam and lamotrigine are preferred, with 5 mg folic acid periconceptionally.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Antiepileptic Drugs",
   "tags": [
