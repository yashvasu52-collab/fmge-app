   "topic": "Arboviruses: dengue, chikungunya, JE, Zika",
   "difficulty": "M",
   "stem": "NS1 antigen testing for dengue is most useful:",
   "options": [
    "Only in convalescence",
    "In the first five days of illness, before IgM appears",
    "After two weeks",
    "Only in severe disease"
   ],
   "correct": 1,
   "concept": "NS1 is detectable from day 1 to about day 5 of fever, filling the diagnostic gap before IgM becomes positive around day 5, so NS1 and IgM together cover the whole illness.",
