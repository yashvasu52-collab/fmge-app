   "topic": "Oral cavity, salivary gland & pharyngeal disease",
   "difficulty": "M",
   "stem": "An absolute indication for tonsillectomy is:",
   "options": [
    "Halitosis",
    "Suspected malignancy of the tonsil",
    "A single episode of tonsillitis",
    "Mild snoring"
   ],
   "correct": 1,
   "concept": "Absolute indications include suspected malignancy, obstructive sleep apnoea from tonsillar hypertrophy and recurrent quinsy. Recurrent tonsillitis meeting the Paradise criteria is a relative indication.",
   "reference": "Dhingra Diseases of Ear, Nose and Throat 8e, Ch. Tonsillectomy",
   "tags": [
    "#high-yield"
   ],
