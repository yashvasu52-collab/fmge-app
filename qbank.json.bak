  {
   "id": "Q_OBG_THI_003",
   "part": "B",
   "subject": "Obstetrics & Gynaecology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Third-stage complications, retained placenta & uterine inversion",
   "difficulty": "M",
   "stem": "Retained placenta is diagnosed when the placenta is undelivered after:",
   "options": [
    "30 minutes of active management of the third stage",
    "5 minutes",
    "2 hours",
    "24 hours"
   ],
   "correct": 0,
   "concept": "Failure of placental delivery within 30 minutes despite active management defines retained placenta, requiring manual removal under anaesthesia with antibiotic cover to prevent haemorrhage and sepsis.",
   "reference": "DC Dutta's Textbook of Obstetrics 9e, Ch. Retained Placenta",
   "tags": [
