  {
   "id": "Q_ENT_VER_007",
   "part": "B",
   "subject": "ENT",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "E",
   "stem": "Loss of taste in the anterior two-thirds of the tongue with facial palsy localises the lesion:",
   "options": [
    "At or above the level where chorda tympani joins the facial nerve",
    "Below the stylomastoid foramen",
    "In the parotid gland",
    "In the facial nucleus only"
   ],
   "correct": 0,
   "concept": "Topodiagnostic testing localises the lesion: taste loss implies involvement at or proximal to the chorda tympani, hyperacusis implies involvement at or above the nerve to stapedius, and reduced lacrimation implies a lesion at or above the geniculate ganglion.",
   "reference": "Dhingra Diseases of Ear, Nose and Throat 8e, Ch. Facial Nerve",
   "tags": [
