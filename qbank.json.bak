   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Childhood tuberculosis & paediatric HIV",
   "difficulty": "M",
   "stem": "Tuberculosis preventive therapy is indicated for a 3-year-old household contact of a sputum-positive case who is:",
   "options": [
    "BCG vaccinated only",
    "Already on treatment",
    "Symptomatic with fever and cough",
    "Asymptomatic with active disease excluded"
   ],
   "correct": 3,
   "concept": "Children under 5 in household contact with a pulmonary tuberculosis case receive preventive therapy once active disease is excluded, since risk of progression is highest at this age. Isoniazid for six months or shorter rifapentine-based regimens are used.",
