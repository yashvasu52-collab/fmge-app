  {
   "id": "Q_GEN_OPHTH_GLAUCOMA_005",
   "subject": "Ophthalmology",
   "topic": "Glaucoma",
   "part": "B",
   "difficulty": "E",
   "stem": "Goldmann applanation tonometry, the clinical gold standard for measuring intraocular pressure, is based on which physical principle?",
   "options": [
    "Poiseuille's law of laminar flow",
    "Imbert-Fick law (pressure equals force divided by the area of applanation)",
    "Snell's law of refraction",
    "Bernoulli's principle"
   ],
   "correct": 1,
   "concept": "Goldmann applanation tonometry flattens a fixed corneal area of 3.06 mm diameter. By the Imbert-Fick principle, the pressure inside a dry, thin-walled sphere equals the applied force divided by the applanated area. The 3.06 mm diameter is chosen so that corneal rigidity and the tear-film surface tension cancel out, and the force in grams multiplied by ten gives IOP in mmHg. Readings are influenced by central corneal thickness.",
   "reference": "Parsons' Diseases of the Eye 23e, Ch. Tonometry",
   "verified": "Y",
   "source": "ai",
   "verified_by": "model-audit",
   "verified_on": "2026-09-01"
  },
  {
