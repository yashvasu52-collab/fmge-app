  {
   "id": "Q_MIC_ARB_009",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Arboviruses: dengue, chikungunya, JE, Zika",
   "difficulty": "H",
   "stem": "Japanese encephalitis vaccine in the Indian programme is given:",
   "options": [
    "Only to adults",
    "As a live attenuated vaccine in endemic districts at 9 months with a booster at 16 to 24 months",
    "At birth",
    "Only during outbreaks"
   ],
   "correct": 1,
   "concept": "The live attenuated SA 14-14-2 vaccine has been incorporated into routine immunisation in endemic districts, along with campaign-mode catch-up vaccination, and has substantially reduced incidence.",
