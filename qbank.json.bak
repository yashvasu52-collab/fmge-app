   "verified_by": "model-audit",
   "topic": "Association & causation, bias, confounding, measures of risk",
   "difficulty": "E",
   "stem": "In a cohort study the incidence of lung cancer is 40 per 1000 in smokers and 8 per 1000 in non-smokers. What is the attributable risk percentage among smokers?",
   "options": [
    "80 percent",
    "20 percent",
    "32 percent",
    "500 percent"
   ],
   "correct": 0,
   "concept": "Attributable risk percentage is the excess risk divided by the risk in the exposed, so 32 divided by 40 gives 80 percent, meaning four-fifths of the disease in smokers is attributable to smoking.",
   "reference": "Park's Textbook of Preventive and Social Medicine 27e, Ch. Epidemiology",
   "verified_on": "2026-09-01",
   "verify_note": "the stem read \"Using the same figures\", which are only given in a different question; served on its own or after shuffling, the item was unanswerable. The figures are now restated in full"
  },
