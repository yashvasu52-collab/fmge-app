  {
   "id": "Q_OR_LL_003",
   "part": "B",
   "subject": "Orthopedics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Specific fractures (Colles, NOF, supracondylar) & healing",
   "difficulty": "M",
   "stem": "In an elderly patient with a displaced intracapsular femoral neck fracture, the treatment of choice is:",
   "options": [
    "Internal fixation with screws",
    "Hemiarthroplasty or total hip replacement",
    "Traction alone",
    "Bed rest"
   ],
   "correct": 1,
   "concept": "Displaced intracapsular fractures in the elderly have high rates of avascular necrosis and non-union after fixation, so replacement allows immediate weight-bearing. Fixation is preferred in the young to preserve the native head.",
