   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_ENT_VER_003",
   "part": "B",
   "subject": "ENT",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "M",
   "stem": "Vertigo lasting several days with hearing loss and no neurological signs, following a viral illness, suggests:",
   "options": [
    "BPPV",
    "Labyrinthitis",
    "Vestibular neuronitis",
    "Meniere disease"
   ],
   "correct": 1,
   "concept": "Labyrinthitis affects both cochlear and vestibular components, giving vertigo with hearing loss, whereas vestibular neuronitis spares hearing. Both last days and settle with vestibular sedatives and early rehabilitation exercises.",
   "reference": "Dhingra Diseases of Ear, Nose and Throat 8e, Ch. Vertigo",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_ENT_VER_004",
   "part": "B",
   "subject": "ENT",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "E",
   "stem": "In the caloric test, cold water irrigation of the ear produces nystagmus with the fast component directed:",
   "options": [
    "Rotatory only",
    "To the opposite side",
    "Vertically upward",
    "To the same side"
   ],
   "correct": 1,
   "concept": "The mnemonic COWS - Cold Opposite, Warm Same - describes the direction of the fast phase. Canal paresis indicates a peripheral vestibular lesion and the test can be performed in unconscious patients to assess brainstem function.",
