  {
   "id": "Q_DE_ACN_009",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Acne, rosacea, hair & nail disorders",
   "difficulty": "H",
   "stem": "Koilonychia (spoon-shaped nails) is classically associated with:",
   "options": [
    "Fungal infection",
    "Psoriasis",
    "Iron deficiency anaemia",
    "Vitamin B12 deficiency"
   ],
   "correct": 2,
   "concept": "Thin brittle nails become flattened then concave in chronic iron deficiency, alongside angular stomatitis, glossitis and, in Plummer-Vinson syndrome, a postcricoid web with dysphagia.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Nail Disorders",
