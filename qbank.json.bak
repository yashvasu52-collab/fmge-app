   "verified_by": "model-audit",
   "topic": "Third-stage complications, retained placenta & uterine inversion",
   "difficulty": "E",
   "stem": "Morbid adherence of the placenta to the myometrium without invading it is termed:",
   "options": [
    "Placenta accreta",
    "Placenta praevia",
    "Placenta increta",
    "Placenta percreta"
   ],
   "correct": 0,
   "concept": "Accreta adheres to superficial myometrium, increta invades the myometrium and percreta penetrates the serosa and may involve the bladder. Previous caesarean with placenta praevia is the major risk factor.",
   "reference": "Williams Obstetrics 26e, Ch. Placenta Accreta Spectrum",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
