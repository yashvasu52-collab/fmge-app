   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Vertigo, Meniere's disease & facial nerve palsy",
   "difficulty": "H",
   "stem": "Unilateral progressive sensorineural hearing loss with tinnitus and absent corneal reflex suggests:",
   "options": [
