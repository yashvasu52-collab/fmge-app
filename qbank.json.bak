  {
   "id": "Q_PH_NSA_010",
   "part": "A",
   "subject": "Pharmacology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "NSAIDs, analgesics, antipyretics & drugs for gout",
   "difficulty": "M",
   "stem": "Probenecid is ineffective and contraindicated in patients with:",
   "options": [
    "Diabetes",
    "Hypertension",
    "Renal impairment or a history of urate stones",
    "Asthma"
   ],
   "correct": 2,
   "concept": "Uricosurics require adequate glomerular filtration to work and increase urinary urate load, risking stone formation, so high fluid intake and urinary alkalinisation are advised. They must never be started during an acute attack.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Gout",
