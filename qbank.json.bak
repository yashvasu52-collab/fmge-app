  {
   "id": "Q_OP_SQU_003",
   "part": "B",
   "subject": "Ophthalmology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Squint, amblyopia & neuro-ophthalmology (optic nerve, pupil, fields)",
   "difficulty": "M",
   "stem": "A relative afferent pupillary defect (Marcus Gunn pupil) indicates:",
   "options": [
    "Asymmetric optic nerve or extensive retinal disease",
    "Refractive error",
    "Corneal scarring",
    "A lens opacity"
   ],
   "correct": 0,
   "concept": "On swinging the torch, the affected pupil dilates because its afferent input is weaker. It is a purely afferent sign, so it never occurs with media opacities such as cataract, and is a key sign in optic neuritis.",
   "reference": "AK Khurana Comprehensive Ophthalmology 8e, Ch. Neuro-ophthalmology",
   "tags": [
