   "difficulty": "M",
   "stem": "Miliary tuberculosis results from:",
   "options": [
    "Haematogenous dissemination producing innumerable small uniform granulomas in multiple organs",
    "Lymphatic spread only",
    "Direct extension",
    "Bronchial spread"
   ],
   "correct": 0,
