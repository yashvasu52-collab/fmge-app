   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Rickettsia, Chlamydia, Mycoplasma",
   "difficulty": "M",
   "stem": "Chlamydia trachomatis serotypes A to C cause:",
   "options": [
    "Lymphogranuloma venereum",
    "Trachoma, a leading infectious cause of blindness",
    "Psittacosis",
    "Urethritis"
   ],
   "correct": 1,
   "concept": "Serotypes A to C cause trachoma with follicular conjunctivitis, pannus, Herbert pits and cicatricial entropion with trichiasis; D to K cause genital infection and inclusion conjunctivitis; L1 to L3 cause LGV.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Chlamydiae",
   "tags": [
