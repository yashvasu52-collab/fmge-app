   "verified_by": "model-audit",
   "topic": "Burns & basics of plastic surgery",
   "difficulty": "E",
   "stem": "The rule of nines assigns what percentage of body surface area to an adult's entire lower limb?",
   "options": [
    "Thirty-six percent",
    "Nine percent",
    "Eighteen percent",
    "Twenty-seven percent"
   ],
   "correct": 2,
   "concept": "In adults the head is 9%, each upper limb 9%, each lower limb 18%, anterior trunk 18%, posterior trunk 18% and perineum 1%. In children the head is proportionately larger and the limbs smaller, so the Lund-Browder chart is more accurate.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Burns",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_BRN_002",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Burns & basics of plastic surgery",
   "difficulty": "M",
   "stem": "The Parkland formula for fluid resuscitation in burns is:",
   "options": [
    "4 mL x body weight in kg x percentage burn of Ringer lactate in 24 hours, half in the first 8 hours",
    "2 mL x weight x percentage over 24 hours",
    "4 mL x weight x percentage of colloid",
    "Maintenance fluids only"
   ],
   "correct": 0,
   "concept": "Parkland gives 4 mL/kg per percent burn of Ringer lactate over 24 hours from the time of injury, with half in the first 8 hours. Urine output of 0.5 to 1 mL/kg/hour is the best guide, as the formula is only a starting estimate.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Burns",
   "tags": [
    "#high-yield",
    "#formula"
   ],
   "verified_on": "2026-09-01",
   "verify_note": "reviewed against a concept-similarity duplicate candidate; answer, topic and reference confirmed"
  },
