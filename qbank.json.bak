  {
   "id": "Q_MIC_STR_006",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "M",
   "stem": "Bacterial spores are formed by:",
   "options": [
    "Bacillus and Clostridium species, conferring extreme resistance to heat and disinfectants",
    "Mycobacteria",
    "All bacteria",
    "Only Gram-negative bacteria"
   ],
   "correct": 0,
   "concept": "Endospores of the aerobic Bacillus and anaerobic Clostridium contain dipicolinic acid and calcium, resisting boiling and most disinfectants, so autoclaving at 121 degrees for 15 minutes is required. Spore destruction is the benchmark of sterilisation.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Morphology and Physiology of Bacteria",
   "tags": [
