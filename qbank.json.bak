  {
   "id": "Q_MIC_STR_003",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "M",
   "stem": "Transduction in bacterial genetics refers to transfer of genetic material by:",
   "options": [
    "Uptake of naked DNA",
    "Direct cell-to-cell contact through a pilus",
    "A bacteriophage",
    "Transposons only"
   ],
   "correct": 2,
   "concept": "Transduction uses a bacteriophage vector, conjugation requires cell contact via a sex pilus transferring plasmids, and transformation is uptake of free DNA. Conjugation is the most important mechanism for spreading multidrug resistance.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Bacterial Genetics",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_STR_004",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "E",
   "stem": "Methicillin resistance in Staphylococcus aureus is mediated by:",
   "options": [
    "The mecA gene encoding an altered penicillin-binding protein PBP2a",
    "Efflux pumps",
    "Porin loss",
    "Beta-lactamase production alone"
   ],
   "correct": 0,
   "concept": "PBP2a has low affinity for all beta-lactams, so MRSA is resistant to the entire class including cephalosporins, and requires vancomycin, linezolid or daptomycin. It is detected by cefoxitin disc testing.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Staphylococcus",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_MIC_STR_005",
   "part": "A",
   "subject": "Microbiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bacterial structure, growth, genetics & antimicrobial resistance",
   "difficulty": "M",
   "stem": "Extended spectrum beta-lactamase producing organisms are best treated with:",
   "options": [
    "Third generation cephalosporins",
    "Cotrimoxazole",
    "Ampicillin",
    "Carbapenems"
   ],
   "correct": 3,
   "concept": "ESBLs hydrolyse penicillins and third-generation cephalosporins including aztreonam but are inhibited by clavulanate; carbapenems are the drugs of choice. Carbapenemase producers such as NDM-1 require colistin or newer agents.",
   "reference": "Ananthanarayan and Paniker's Textbook of Microbiology 11e, Ch. Antimicrobial Resistance",
   "tags": [
    "#high-yield",
