  {
   "id": "Q_SUR_HED_010",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Head injury & neurosurgical emergencies",
   "difficulty": "M",
   "stem": "A chronic subdural haematoma in an elderly patient typically presents with:",
   "options": [
    "Fluctuating confusion, headache and progressive focal deficit weeks after trivial trauma",
    "Immediate hemiplegia",
    "Fever and neck stiffness",
    "Sudden coma"
   ],
   "correct": 0,
   "concept": "Cerebral atrophy stretches bridging veins so minor trauma, often forgotten, produces a slowly enlarging collection presenting weeks later with confusion, headache and gait disturbance. Burr-hole drainage gives excellent results.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Head Injury",
