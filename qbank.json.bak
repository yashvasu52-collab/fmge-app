  {
   "id": "Q_SUR_LIV_005",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Liver, spleen & portal hypertension surgery",
   "difficulty": "M",
   "stem": "A liver abscess in India is most commonly:",
   "options": [
    "Tubercular",
    "Pyogenic and multiple",
    "Hydatid",
    "Amoebic, solitary and in the right lobe"
   ],
   "correct": 3,
   "concept": "Amoebic liver abscess from Entamoeba histolytica is usually solitary in the right lobe with anchovy-sauce pus that is sterile on culture. Metronidazole is curative, with aspiration for large or left-lobe abscesses or impending rupture.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Liver",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
