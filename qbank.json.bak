  {
   "id": "Q_MED_COAG_017",
   "part": "B",
   "subject": "Medicine",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Bleeding disorders, thrombophilia & anticoagulation",
   "difficulty": "M",
   "stem": "Warfarin-induced skin necrosis in the first days of therapy is due to:",
   "options": [
    "Heparin cross-reactivity",
    "Direct toxic effect on skin",
    "Immune vasculitis",
    "Early fall in protein C creating a transient prothrombotic state"
   ],
   "correct": 3,
   "concept": "Protein C has a short half-life like factor VII, so anticoagulant protein falls before the procoagulant factors II and X, which is also why heparin must overlap warfarin initiation.",
   "reference": "Harrison's Principles of Internal Medicine 21e, Ch. 65 (Disorders of Coagulation and Thrombosis)",
   "verified_on": "2026-09-01"
