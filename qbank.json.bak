   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_SUR_CHT_007",
   "part": "B",
   "subject": "Surgery",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Chest trauma & thoracic surgery",
   "difficulty": "E",
   "stem": "A tension pneumothorax is distinguished clinically from a simple pneumothorax by:",
   "options": [
    "Hypotension with tracheal deviation away and distended neck veins",
    "Pleuritic rub",
    "Absence of breath sounds alone",
    "Chest pain"
   ],
   "correct": 0,
   "concept": "Progressive air trapping shifts the mediastinum, kinking the great veins and reducing venous return, so cardiovascular collapse dominates. It is a clinical diagnosis treated by immediate needle decompression before any radiograph.",
   "reference": "Bailey & Love's Short Practice of Surgery 28e, Ch. Thoracic Trauma",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01"
  },
  {
