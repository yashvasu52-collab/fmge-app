   "verified_by": "model-audit",
   "topic": "Abortion, ectopic pregnancy, recurrent pregnancy loss",
   "difficulty": "H",
   "stem": "Which uterine anomaly carries the highest risk of mid-trimester loss and is amenable to hysteroscopic correction?",
   "options": [
    "Arcuate uterus",
    "Bicornuate uterus",
    "Unicornuate uterus",
    "Septate uterus"
   ],
   "correct": 3,
   "concept": "The poorly vascularised fibromuscular septum implants badly, and hysteroscopic septal resection improves outcomes, whereas a bicornuate uterus requires abdominal metroplasty and an arcuate uterus is a normal variant.",
   "reference": "DC Dutta's Textbook of Obstetrics 9e, Ch. Abortion and Ectopic Pregnancy",
   "verified_on": "2026-09-01"
  },
