  {
   "id": "Q_PED_DIA_008",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Fluid & electrolyte therapy and diarrhoeal disease in children",
   "difficulty": "H",
   "stem": "Hyponatraemic dehydration in a child is corrected slowly because rapid correction risks:",
   "options": [
    "Hypokalaemia",
    "Renal failure",
    "Cerebral oedema",
    "Osmotic demyelination syndrome"
   ],
   "correct": 3,
   "concept": "Overly rapid correction of chronic hyponatraemia dehydrates brain cells causing osmotic demyelination, so sodium is raised by no more than 8 to 10 mmol/L in 24 hours. Conversely, too-rapid correction of hypernatraemia causes cerebral oedema.",
   "reference": "OP Ghai Essential Pediatrics 9e, Ch. Fluid and Electrolytes; Harrison's Principles of Internal Medicine 21e, Ch. Fluid and Electrolyte Disturbances",
   "tags": [
