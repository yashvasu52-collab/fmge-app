   "part": "B",
   "subject": "PSM (Community Medicine)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "International health, WHO, SDGs & disaster management",
   "difficulty": "E",
   "stem": "The International Health Regulations require member states to notify WHO of:",
   "options": [
    "Only outbreaks over 100 cases",
    "Only plague, cholera and yellow fever",
    "All infectious diseases",
    "Any event that may constitute a public health emergency of international concern"
   ],
   "correct": 3,
   "concept": "The 2005 revision moved from a fixed disease list to an all-hazards approach with a decision instrument, requiring core surveillance and response capacity at points of entry.",
