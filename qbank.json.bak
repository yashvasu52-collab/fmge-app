  {
   "id": "Q_PED_EMG_008",
   "part": "B",
   "subject": "Pediatrics",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "PEM, breastfeeding, micronutrients",
   "difficulty": "H",
   "stem": "Severe acute malnutrition in a child 6 to 59 months is defined by any of:",
   "options": [
    "MUAC below 13.5 cm",
    "Weight-for-height below minus 3 SD, MUAC below 11.5 cm, or bilateral pedal oedema",
    "Weight-for-age below minus 2 SD only",
    "Height-for-age below minus 3 SD"
   ],
   "correct": 1,
   "concept": "Any one of these criteria defines severe acute malnutrition. Management follows the WHO ten steps, treating hypoglycaemia, hypothermia, dehydration, electrolytes and infection before cautious feeding to avoid refeeding syndrome.",
   "reference": "WHO Guideline: Updates on the Management of Severe Acute Malnutrition in Infants and Children 2013; OP Ghai Essential Pediatrics 9e, Ch. Nutrition and Malnutrition",
   "tags": [
