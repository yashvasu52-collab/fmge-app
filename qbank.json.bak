  {
   "id": "Q_FM_ALC_008",
   "part": "A",
   "subject": "Forensic Medicine (FMT)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Alcohol, opioids, sedatives & drugs of abuse (medico-legal)",
   "difficulty": "H",
   "stem": "Drug-facilitated sexual assault most commonly involves:",
   "options": [
    "Alcohol, with benzodiazepines such as flunitrazepam and gamma-hydroxybutyrate",
    "Only cannabis",
    "Only cocaine",
    "Only opioids"
   ],
   "correct": 0,
   "concept": "Alcohol remains by far the commonest agent. Rapid metabolism means urine must be collected as early as possible, and specific request for a drug screen is needed as routine panels may miss these agents.",
   "reference": "Reddy's The Essentials of Forensic Medicine and Toxicology 34e, Ch. Toxicology",
   "tags": [
