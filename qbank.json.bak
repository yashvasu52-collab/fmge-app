  {
   "id": "Q_DE_PIG_001",
   "part": "B",
   "subject": "Dermatology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Pigmentary disorders (vitiligo, melasma) & genodermatoses",
   "difficulty": "E",
   "stem": "Vitiligo is characterised by:",
   "options": [
    "Hyperpigmentation",
    "Depigmented macules with autoimmune destruction of melanocytes",
    "Scaling",
    "Hypopigmented anaesthetic patches"
   ],
   "correct": 1,
   "concept": "Well-defined chalk-white macules that fluoresce under Wood lamp, often around orifices and over bony prominences, with associated thyroid disease, diabetes and pernicious anaemia. Sensation is normal, unlike leprosy.",
   "reference": "IADVL Textbook of Dermatology 5e, Ch. Pigmentary Disorders",
   "tags": [
