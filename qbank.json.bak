   "verified_by": "model-audit",
   "topic": "Menopause, HRT & osteoporosis",
   "difficulty": "H",
   "stem": "The most feared adverse effect of prolonged bisphosphonate therapy is:",
   "options": [
    "Hepatic failure",
    "Pulmonary fibrosis",
    "Osteonecrosis of the jaw and atypical femoral fracture",
    "Cataract"
   ],
   "correct": 2,
   "concept": "Long-term suppression of bone turnover can cause osteonecrosis of the jaw, especially after dental extraction, and atypical subtrochanteric femoral fractures, prompting consideration of a drug holiday after 3 to 5 years.",
   "reference": "KD Tripathi Essentials of Medical Pharmacology 8e, Ch. Drugs for Osteoporosis",
   "tags": [
