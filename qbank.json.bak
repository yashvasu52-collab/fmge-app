   ],
   "verified_on": "2026-09-01"
  },
  {
   "id": "Q_FM_ALC_007",
   "part": "A",
   "subject": "Forensic Medicine (FMT)",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Alcohol, opioids, sedatives & drugs of abuse (medico-legal)",
   "difficulty": "E",
   "stem": "Cannabis preparations in order of increasing potency are:",
   "options": [
    "Charas, ganja, bhang",
    "Bhang, ganja, charas",
    "Ganja, charas, bhang",
    "All equal"
   ],
   "correct": 1,
   "concept": "Bhang comes from dried leaves, ganja from flowering tops, and charas is the resin, the most potent. Run amok and delirium may occur, and the drug is controlled under the NDPS Act.",
   "reference": "Reddy's The Essentials of Forensic Medicine and Toxicology 34e, Ch. Toxicology",
   "tags": [
