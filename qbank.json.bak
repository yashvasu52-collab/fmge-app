  {
   "id": "Q_PY_GIT_005",
   "part": "A",
   "subject": "Physiology",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "GIT secretions, motility & absorption",
   "difficulty": "M",
   "stem": "Bile salts are essential for absorption of:",
   "options": [
    "Glucose",
    "Fat and fat-soluble vitamins A, D, E and K",
    "Amino acids",
    "Iron"
   ],
   "correct": 1,
   "concept": "About 95% of bile salts are reabsorbed in the terminal ileum and recycled through the enterohepatic circulation. Ileal disease therefore causes both steatorrhoea and bile-salt diarrhoea.",
   "reference": "Ganong's Review of Medical Physiology 26e, Ch. Gastrointestinal Physiology",
   "tags": [
