  {
   "id": "Q_PS_SOM_009",
   "part": "B",
   "subject": "Psychiatry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Somatoform, dissociative, personality & sexual disorders",
   "difficulty": "H",
   "stem": "Premature ejaculation is most effectively treated with:",
   "options": [
    "Beta blockers",
    "Antipsychotics",
    "Testosterone",
    "Behavioural techniques such as stop-start and squeeze, with SSRIs if needed"
   ],
   "correct": 3,
   "concept": "Squeeze and stop-start techniques with partner involvement are first line; SSRIs delay ejaculation as a therapeutic use of a common side effect, and topical anaesthetics are an alternative.",
   "reference": "Kaplan & Sadock's Synopsis of Psychiatry 12e, Ch. Sexual Dysfunctions",
   "tags": [
