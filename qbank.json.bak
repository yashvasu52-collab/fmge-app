  },
  {
   "id": "Q_BC_MIN_010",
   "part": "A",
   "subject": "Biochemistry",
   "source": "ai",
   "verified": "Y",
   "verified_by": "model-audit",
   "topic": "Minerals, trace elements & acid-base biochemistry",
   "difficulty": "M",
   "stem": "Zinc is a cofactor for many enzymes, and its deficiency causes:",
   "options": [
    "Anaemia only",
    "Rickets",
    "Goitre",
    "Poor wound healing, impaired taste, diarrhoea and acral dermatitis"
   ],
   "correct": 3,
   "concept": "Zinc supplementation shortens childhood diarrhoea and reduces recurrence, which is why the national programme pairs zinc with ORS. Acrodermatitis enteropathica is the inherited absorptive defect.",
   "reference": "Harper's Illustrated Biochemistry 32e, Ch. Micronutrients: Vitamins and Minerals",
   "tags": [
    "#high-yield"
   ],
   "verified_on": "2026-09-01",
